{
  "name": "QuantumArena",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false,
        "CameraMaxZoomDistance": 40
      },
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "Players": {
      "$properties": { "RespawnTime": 4 }
    },
    "Workspace": {
      "$properties": { "StreamingEnabled": false }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 0,
        "Brightness": 1.5,
        "GlobalShadows": true
      }
    },
    "SoundService": {
      "$properties": { "RespectFilteringEnabled": true }
    }
  }
}
