	Description = "ดาบที่อยู่หลายที่ในเวลาเดียวกัน",
	Basic = {
		Name = "ฟันดาบ",
		Type = "MeleeCombo",
		Damage = { 10, 10, 16 }, Range = 8, Width = 8, Cooldown = 0.35,
	},
