			DamageText = "–", Cooldown = 22, Range = 0, Targeting = "Self",
			Radius = 20, Duration = 2,
		},
		{
			Id = "Rewind", Name = "ย้อนเวลา", Icon = "⏪",
			Description = "กลับไปที่ตำแหน่งและเลือดเมื่อ 3 วิก่อน",
