]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">VFX</string>
          <string name="Source"><![CDATA[-- ฟังก์ชันเอฟเฟกต์ที่ใช้ร่วมกัน (รันฝั่ง client เท่านั้น)
-- ทุกอย่างสร้างจาก Part / Neon / ParticleEmitter / Beam / Trail / Highlight ไม่ใช้ asset ภายนอก
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local VFX = {}

VFX.SmokeZones = {} -- { Position, Radius, Expires } ให้ VFXController ใช้ซ่อนชื่อ/แถบเลือด

local effectsFolder
local function getFolder()
	if not effectsFolder or not effectsFolder.Parent then
		effectsFolder = Instance.new("Folder")
		effectsFolder.Name = "LocalEffects"
		effectsFolder.Parent = Workspace
	end
	return effectsFolder
end

local WHITE = Color3.new(1, 1, 1)

local function newPart(props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		part[key] = value
	end
	part.Parent = getFolder()
	return part
end

local function tween(instance, duration, goals, style, direction)
	local info = TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local t = TweenService:Create(instance, info, goals)
	t:Play()
	return t
end

-- ทำให้หายไปแล้วลบทิ้ง
local function fadeOut(part, duration, extraGoals)
	local goals = extraGoals or {}
	goals.Transparency = 1
	tween(part, duration, goals)
	Debris:AddItem(part, duration + 0.05)
end

-- พ่นอนุภาคครั้งเดียว
local function burst(position, color, count, speed, lifetime, size)
	local holder = newPart({ Size = Vector3.new(0.2, 0.2, 0.2), Position = position, Transparency = 1 })
	local emitter = Instance.new("ParticleEmitter")
	emitter.Enabled = false
	emitter.Color = ColorSequence.new(color, WHITE)
	emitter.LightEmission = 1
	emitter.Lifetime = NumberRange.new(lifetime * 0.5, lifetime)
	emitter.Speed = NumberRange.new(speed * 0.4, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Drag = 3
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, size or 0.6),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Parent = holder
	emitter:Emit(count)
	Debris:AddItem(holder, lifetime + 0.2)
end

local function flash(position, color, range, duration)
	local holder = newPart({ Size = Vector3.new(0.2, 0.2, 0.2), Position = position, Transparency = 1 })
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = 4
	light.Parent = holder
	tween(light, duration, { Brightness = 0 })
	Debris:AddItem(holder, duration + 0.05)
end

-- แผ่นกลมแนวนอน
local function disc(position, radius, height, props)
	props = props or {}
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(height, radius * 2, radius * 2)
	props.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	return newPart(props)
end

local function flatUnit(direction)
	local flat = Vector3.new(direction.X, 0, direction.Z)
	if flat.Magnitude < 0.05 then
		return Vector3.new(0, 0, -1)
	end
	return flat.Unit
end

local function rootOf(character)
	return character and character.Parent and character:FindFirstChild("HumanoidRootPart")
end

---------------------------------------------------------------------------
-- ตัวอัปเดตรายเฟรม (กระสุน, ของที่ต้องตามตัวละคร)
---------------------------------------------------------------------------
local updaters = {}

local function addUpdater(callback)
	table.insert(updaters, callback)
end

local stepped = RunService:IsClient() and RunService.RenderStepped or RunService.Heartbeat
stepped:Connect(function(dt)
	for i = #updaters, 1, -1 do
		local ok, keep = pcall(updaters[i], dt)
		if not ok or not keep then
			table.remove(updaters, i)
		end
	end
end)

---------------------------------------------------------------------------
-- เอฟเฟกต์พื้นฐาน
---------------------------------------------------------------------------

function VFX.Hit(data)
	burst(data.Position, data.Color, 8, 14, 0.3, 0.5)
	local ball = newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.5, 1.5, 1.5),
		Position = data.Position,
		Color = data.Color,
		Transparency = 0.3,
	})
	fadeOut(ball, 0.18, { Size = Vector3.new(4, 4, 4) })
end

function VFX.Explosion(data)
	local radius = data.Radius or 6
	local duration = data.Duration or 0.4
	local ball = newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1, 1, 1),
		Position = data.Position,
		Color = data.Color,
		Transparency = 0.25,
	})
	fadeOut(ball, duration, { Size = Vector3.new(radius * 2, radius * 2, radius * 2) })
	local ring = disc(data.Position, 0.5, 0.3, { Color = data.Color, Transparency = 0.2 })
	fadeOut(ring, duration * 1.2, { Size = Vector3.new(0.3, radius * 2.4, radius * 2.4) })
	burst(data.Position, data.Color, math.clamp(math.floor(radius * 3), 10, 60), radius * 3, duration + 0.2, 0.8)
	flash(data.Position, data.Color, radius * 2.5, duration)
end

-- วงเตือนบนพื้น ค่อย ๆ เต็มจนถึงเวลาที่สกิลลง
function VFX.Telegraph(data)
	local position = data.Position + Vector3.new(0, 0.15, 0)
	local outer = disc(position, data.Radius, 0.1, { Color = data.Color, Transparency = 0.8 })
	local inner = disc(position + Vector3.new(0, 0.05, 0), 0.5, 0.1, { Color = data.Color, Transparency = 0.5 })
	tween(inner, data.Duration, { Size = Vector3.new(0.1, data.Radius * 2, data.Radius * 2) }, Enum.EasingStyle.Linear)
	Debris:AddItem(outer, data.Duration)
	Debris:AddItem(inner, data.Duration)
end

function VFX.LineTelegraph(data)
	local drop = Vector3.new(0, 2.7, 0)
	local from, to = data.From - drop, data.To - drop
	local length = (to - from).Magnitude
	if length < 0.1 then
		return
	end
	local mid = (from + to) / 2
	local strip = newPart({
		Size = Vector3.new(data.Width, 0.15, length),
		CFrame = CFrame.lookAt(mid, to),
		Color = data.Color,
		Transparency = 0.85,
	})
	tween(strip, data.Duration, { Transparency = 0.35 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Debris:AddItem(strip, data.Duration)
end

function VFX.Beam(data)
	local from, to = data.From, data.To
	local length = (to - from).Magnitude
	if length < 0.1 then
		return
	end
	local width = data.Width or 0.4
	local duration = data.Duration or 0.2
	local beam = newPart({
		Size = Vector3.new(width, width, length),
		CFrame = CFrame.lookAt((from + to) / 2, to),
		Color = data.Color,
		Transparency = 0.1,
	})
	fadeOut(beam, duration, { Size = Vector3.new(width * 0.1, width * 0.1, length) })
	if width >= 1.5 then
		flash(to, data.Color, 20, duration)
		burst(to, data.Color, 14, 20, 0.4, 0.7)
	end
end

function VFX.Lightning(data)
	local from, to = data.From, data.To
	local total = (to - from).Magnitude
	if total < 0.1 then
		return
	end
	local width = data.Width or 0.4
	local segments = math.clamp(math.floor(total / 5), 3, 16)
	local previous = from
	for i = 1, segments do
		local point = from:Lerp(to, i / segments)
		if i < segments then
			local jitter = math.min(3, total * 0.08)
			point += Vector3.new(
				(math.random() - 0.5) * 2 * jitter,
				(math.random() - 0.5) * 2 * jitter,
				(math.random() - 0.5) * 2 * jitter
			)
		end
		local length = (point - previous).Magnitude
		if length > 0.05 then
			local segment = newPart({
				Size = Vector3.new(width, width, length),
				CFrame = CFrame.lookAt((previous + point) / 2, point),
				Color = data.Color,
			})
			local core = newPart({
				Size = Vector3.new(width * 0.4, width * 0.4, length),
				CFrame = segment.CFrame,
				Color = WHITE,
			})
			fadeOut(segment, 0.25)
			fadeOut(core, 0.2)
		end
		previous = point
	end
	flash(to, data.Color, 18, 0.25)
	burst(to, data.Color, 10, 18, 0.3, 0.5)
end

---------------------------------------------------------------------------
-- กระสุน (ภาพอย่างเดียว server เป็นคนคิดดาเมจ)
---------------------------------------------------------------------------
local function addTrail(part, color, height, lifetime)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, height, 0)
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -height, 0)
	a1.Parent = part
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(color)
	trail.LightEmission = 1
	trail.Lifetime = lifetime
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.FaceCamera = true
	trail.Parent = part
end

-- คืนค่ารายการชิ้นส่วน { Part, Offset } ของกระสุนแต่ละแบบ
local function buildProjectile(style, size, color, dark)
	local pieces = {}
	local function add(props, offset)
		props.Color = props.Color or color
		local part = newPart(props)
		table.insert(pieces, { Part = part, Offset = offset or CFrame.new() })
		return part
	end

	local spin = 0
	if style == "Needle" then
		local part = add({ Size = Vector3.new(0.2, 0.2, 2.4) })
		addTrail(part, color, 0.15, 0.15)
	elseif style == "Bolt" then
		local part = add({ Size = Vector3.new(0.5, 0.5, 7) })
		add({ Size = Vector3.new(0.2, 0.2, 7.4), Color = WHITE })
		addTrail(part, color, 0.5, 0.2)
	elseif style == "Blade" then
		local part = add({ Size = Vector3.new(0.25, 0.7, 4.2) })
		addTrail(part, color, 0.4, 0.2)
		spin = 14
	elseif style == "Shuriken" then
		local part = add({ Size = Vector3.new(1.6, 0.15, 0.35) })
		add({ Size = Vector3.new(0.35, 0.15, 1.6) })
		addTrail(part, color, 0.2, 0.15)
		spin = 30
	elseif style == "Hook" then
		local part = add({ Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size) })
		addTrail(part, color, 0.25, 0.6)
	elseif style == "Crescent" then
		-- พระจันทร์เสี้ยว: ชิ้นเรียงเป็นส่วนโค้ง
		local half = size / 2
		local count = 7
		for i = 1, count do
			local t = (i - 1) / (count - 1) * 2 - 1 -- -1..1
			local x = t * half
			local z = (t * t) * half * 0.55
			local yaw = -t * math.rad(38)
			local thickness = 1.1 - math.abs(t) * 0.7
			local part = add({
				Size = Vector3.new(size / count + 0.5, 0.35, thickness),
				Color = dark and Color3.fromRGB(25, 10, 45) or color,
				Material = dark and Enum.Material.SmoothPlastic or Enum.Material.Neon,
			}, CFrame.new(x, 0, z) * CFrame.Angles(0, yaw, 0))
			if dark then
				add({ Size = Vector3.new(size / count + 0.5, 0.15, 0.25) }, CFrame.new(x, 0, z - thickness / 2) * CFrame.Angles(0, yaw, 0))
			end
			if i == 1 or i == count then
				addTrail(part, color, 0.2, 0.2)
			end
		end
	elseif style == "Wave" then
		add({ Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), Transparency = 0.65 })
		local ring = add({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, size, size), Transparency = 0.3 }, CFrame.Angles(0, math.rad(90), 0))
		addTrail(ring, color, size / 2, 0.15)
	else -- Orb
		local part = add({ Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size) })
		add({ Shape = Enum.PartType.Ball, Size = Vector3.new(size * 0.5, size * 0.5, size * 0.5), Color = WHITE })
		addTrail(part, color, size * 0.4, 0.2)
	end
	return pieces, spin
end

function VFX.Projectile(data)
	local direction = data.Direction
	local pieces, spinSpeed = buildProjectile(data.Style or "Orb", data.Size or 1, data.Color, data.Dark)

	local params = RaycastParams.new()
	local filter = {}
	if data.Pierce then
		-- กระสุนทะลุคน: ภาพหยุดเฉพาะเมื่อชนแผนที่
		params.FilterType = Enum.RaycastFilterType.Include
		table.insert(filter, Workspace:FindFirstChild("Map"))
	else
		params.FilterType = Enum.RaycastFilterType.Exclude
		table.insert(filter, getFolder())
		for _, item in ipairs({ "Effects" }) do
			table.insert(filter, Workspace:FindFirstChild(item))
		end
		if typeof(data.Owner) == "Instance" then
			table.insert(filter, data.Owner)
		end
	end
	params.FilterDescendantsInstances = filter
	params.RespectCanCollide = true

	local position = data.Origin
	local traveled = 0
	local spin = 0

	local function place()
		local base = CFrame.lookAt(position, position + direction)
		if spinSpeed ~= 0 then
			base *= CFrame.Angles(0, spin, 0)
		end
		for _, piece in ipairs(pieces) do
			piece.Part.CFrame = base * piece.Offset
		end
	end

	local function finish(hitPosition)
		for _, piece in ipairs(pieces) do
			piece.Part.Transparency = 1
			Debris:AddItem(piece.Part, 0.3)
		end
		if hitPosition then
			burst(hitPosition, data.Color, 10, 16, 0.3, 0.6)
		end
	end

	place()
	addUpdater(function(dt)
		local step = math.min(data.Speed * dt, data.Range - traveled)
		local result = Workspace:Raycast(position, direction * (step + 0.5), params)
		if result then
			position = result.Position
			place()
			finish(result.Position)
			return false
		end
		position += direction * step
		traveled += step
		spin += spinSpeed * dt
		place()
		if traveled >= data.Range - 0.01 then
			finish(nil)
			return false
		end
		return true
	end)
end

-- ของที่ปาเป็นวิถีโค้ง (ระเบิดพลังงาน)
function VFX.Arc(data)
	local from, to = data.From, data.To
	local size = data.Size or 1.5
	local ball = newPart({ Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), Position = from, Color = data.Color })
	addTrail(ball, data.Color, size * 0.4, 0.25)
	local height = math.max(6, (to - from).Magnitude * 0.35)
	local elapsed = 0
	addUpdater(function(dt)
		elapsed += dt
		local t = math.min(elapsed / data.Duration, 1)
		ball.Position = from:Lerp(to, t) + Vector3.new(0, math.sin(t * math.pi) * height, 0)
		if t >= 1 then
			ball.Transparency = 1
			Debris:AddItem(ball, 0.3)
			return false
		end
		return true
	end)
end

---------------------------------------------------------------------------
-- ฟัน / หมุน / พุ่ง
---------------------------------------------------------------------------
local function arc(center, forward, radius, spanDegrees, segments, color, thickness, flip, stagger)
	local base = CFrame.lookAt(center, center + forward)
	for i = 1, segments do
		local t = (i - 0.5) / segments
		if flip then
			t = 1 - t
		end
		local angle = math.rad(-spanDegrees / 2 + spanDegrees * t)
		local cf = base * CFrame.Angles(0, -angle, 0) * CFrame.new(0, 0, -radius)
		local segmentLength = 2 * math.pi * radius * (spanDegrees / 360) / segments + 0.4
		task.delay((i - 1) * stagger, function()
			local part = newPart({
				Size = Vector3.new(segmentLength, 0.25, thickness),
				CFrame = cf,
				Color = color,
				Transparency = 0.1,
			})
			fadeOut(part, 0.2, { Size = Vector3.new(segmentLength, 0.05, thickness * 0.3) })
		end)
	end
end

function VFX.Slash(data)
	local forward = flatUnit(data.Direction)
	local range = data.Range or 8
	local span = math.clamp((data.Width or 8) * 11, 60, 170)
	local segments = data.Small and 4 or 8
	local thickness = data.Final and 2.2 or 1.2
	if data.Small then
		thickness = 0.8
	end
	arc(data.Position, forward, range * 0.75, span, segments, data.Color, thickness, data.Flip, 0.012)
	if data.Final then
		arc(data.Position, forward, range * 0.5, span, segments, WHITE, 0.6, data.Flip, 0.012)
		burst(data.Position + forward * range * 0.7, data.Color, 10, 16, 0.3, 0.6)
	end
end

function VFX.Spin(data)
	local root = rootOf(data.Target)
	local position = root and root.Position or data.Position
	if not position then
		return
	end
	arc(position, Vector3.new(0, 0, -1), data.Radius * 0.85, 360, 20, data.Color, 2, false, 0.012)
	arc(position, Vector3.new(0, 0, -1), data.Radius * 0.5, 360, 14, WHITE, 0.6, true, 0.012)
	burst(position, data.Color, 16, data.Radius * 2, 0.35, 0.7)
end

function VFX.Dash(data)
	VFX.Beam({ From = data.From, To = data.To, Color = data.Color, Width = 1.2, Duration = 0.3 })
	burst(data.From, data.Color, 8, 10, 0.3, 0.6)
	burst(data.To, data.Color, 8, 10, 0.3, 0.6)
end

-- ร่างเงา/ร่างควอนตัม (ภาพค้าง)
function VFX.Ghost(data)
	local duration = data.Duration or 0.5
	local shapes = {
		{ Vector3.new(2, 2, 1), CFrame.new(0, 0, 0) },
		{ Vector3.new(1.2, 1.2, 1.2), CFrame.new(0, 1.6, 0) },
		{ Vector3.new(0.9, 2, 0.9), CFrame.new(-0.5, -2, 0) },
		{ Vector3.new(0.9, 2, 0.9), CFrame.new(0.5, -2, 0) },
		{ Vector3.new(0.9, 2, 0.9), CFrame.new(-1.5, 0, 0) },
		{ Vector3.new(0.9, 2, 0.9), CFrame.new(1.5, 0, 0) },
	}
	for _, shape in ipairs(shapes) do
		local part = newPart({ Size = shape[1], CFrame = data.CFrame * shape[2], Color = data.Color, Transparency = 0.35 })
		fadeOut(part, duration)
	end
end

---------------------------------------------------------------------------
-- พื้นที่ค้าง (หลุมดำ / หน่วงเวลา / ควัน)
---------------------------------------------------------------------------
function VFX.Zone(data)
	local radius, duration = data.Radius, data.Duration
	local diameter = radius * 2
	local kind = data.Kind
	local parts = {}

	local sphere = newPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1, 1, 1),
		Position = data.Position,
		Color = data.Color,
		Transparency = 1,
	})
	table.insert(parts, sphere)

	local emitter = Instance.new("ParticleEmitter")
	emitter.Shape = Enum.ParticleEmitterShape.Sphere
	emitter.LightEmission = 1
	emitter.Color = ColorSequence.new(data.Color)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })

	local targetTransparency = 0.85
	if kind == "BlackHole" then
		targetTransparency = 0.8
		emitter.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
		emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		emitter.Rate = 90
		emitter.Speed = NumberRange.new(radius * 1.2)
		emitter.Lifetime = NumberRange.new(0.6, 0.8)
		local core = newPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1, 1, 1),
			Position = data.Position,
			Color = Color3.new(0, 0, 0),
			Material = Enum.Material.SmoothPlastic,
		})
		tween(core, 0.3, { Size = Vector3.new(5, 5, 5) })
		table.insert(parts, core)
		local halo = newPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1, 1, 1),
			Position = data.Position,
			Color = data.Color,
			Transparency = 0.5,
		})
		tween(halo, 0.3, { Size = Vector3.new(6.5, 6.5, 6.5) })
		table.insert(parts, halo)
	elseif kind == "Smoke" then
		targetTransparency = 0.45
		sphere.Material = Enum.Material.SmoothPlastic
		emitter.LightEmission = 0
		emitter.Rate = 40
		emitter.Speed = NumberRange.new(1, 3)
		emitter.Lifetime = NumberRange.new(1.5, 2.5)
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 6) })
		emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
		table.insert(VFX.SmokeZones, { Position = data.Position, Radius = radius, Expires = os.clock() + duration })
	else -- SlowField
		emitter.Rate = 25
		emitter.Speed = NumberRange.new(0.5, 1.5)
		emitter.Lifetime = NumberRange.new(1.2, 2)
		local ring = disc(data.Position - Vector3.new(0, 1.8, 0), radius, 0.15, { Color = data.Color, Transparency = 0.7 })
		table.insert(parts, ring)
	end
	emitter.Parent = sphere

	tween(sphere, 0.25, { Size = Vector3.new(diameter, diameter, diameter), Transparency = targetTransparency })

	task.delay(duration, function()
		emitter.Enabled = false
		for _, part in ipairs(parts) do
			fadeOut(part, 0.4)
		end
	end)
end

---------------------------------------------------------------------------
-- เอฟเฟกต์ที่ติดกับตัวละคร
---------------------------------------------------------------------------
local function highlight(character, color, duration, fillTransparency)
	local h = Instance.new("Highlight")
	h.Name = "QA_Aura"
	h.FillColor = color
	h.OutlineColor = color
	h.FillTransparency = fillTransparency or 0.6
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Parent = character
	Debris:AddItem(h, duration)
	return h
end

-- ชิ้นส่วนที่โคจรรอบตัวละคร
local function orbit(character, duration, count, radius, height, speed, makePiece)
	local pieces = {}
	for i = 1, count do
		pieces[i] = makePiece(i)
	end
	local elapsed = 0
	addUpdater(function(dt)
		elapsed += dt
		local root = rootOf(character)
		if elapsed >= duration or not root then
			for _, piece in ipairs(pieces) do
				piece:Destroy()
			end
			return false
		end
		for i, piece in ipairs(pieces) do
			local angle = elapsed * speed + (i - 1) * (2 * math.pi / count)
			piece.CFrame = CFrame.new(root.Position + Vector3.new(0, height, 0))
				* CFrame.Angles(0, angle, 0)
				* CFrame.new(0, 0, -radius)
		end
		return true
	end)
end

function VFX.Aura(data)
	local character = data.Target
	if not rootOf(character) then
		return
	end
	local kind, color, duration = data.Kind, data.Color, data.Duration

	if kind == "Phase" then
		highlight(character, Color3.fromRGB(230, 220, 255), duration, 0.25)
	elseif kind == "Parry" then
		highlight(character, color, duration, 0.4)
		orbit(character, duration, 3, 3, 0, 14, function()
			return newPart({ Size = Vector3.new(2.4, 4, 0.2), Color = color, Transparency = 0.4 })
		end)
	elseif kind == "BladeStorm" then
		local radius = (data.Radius or 10) * 0.75
		orbit(character, duration, 5, radius, 0, 11, function()
			return newPart({ Size = Vector3.new(0.25, 0.7, 4.5), Color = color })
		end)
		orbit(character, duration, 3, radius * 0.5, 1, -13, function()
			return newPart({ Size = Vector3.new(0.2, 0.5, 3.5), Color = WHITE })
		end)
	elseif kind == "Bomb" then
		highlight(character, color, duration, 0.7)
		local bomb = newPart({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), Color = color })
		local elapsed = 0
		addUpdater(function(dt)
			elapsed += dt
			local root = rootOf(character)
			if elapsed >= duration or not root then
				bomb:Destroy()
				return false
			end
			-- กะพริบถี่ขึ้นเมื่อใกล้ระเบิด
			local pulse = math.sin(elapsed * (6 + elapsed * 8)) * 0.5 + 0.5
			local size = 1.2 + pulse * 0.9
			bomb.Size = Vector3.new(size, size, size)
			bomb.Position = root.Position + Vector3.new(0, 4.5, 0)
			return true
		end)
	elseif kind == "Charge" then
		highlight(character, color, duration, 0.5)
		orbit(character, duration, 4, 2.5, 0.5, 9, function()
			return newPart({ Shape = Enum.PartType.Ball, Size = Vector3.new(0.6, 0.6, 0.6), Color = color })
		end)
	else -- Overdrive และอื่น ๆ
		highlight(character, color, duration, 0.55)
	end
end

function VFX.Status(data)
	local character = data.Target
	if not rootOf(character) then
		return
	end
	local kind, duration = data.Kind, data.Duration
	if kind == "Stun" then
		orbit(character, duration, 3, 1.6, 3.4, 6, function()
			return newPart({ Shape = Enum.PartType.Ball, Size = Vector3.new(0.6, 0.6, 0.6), Color = Color3.fromRGB(255, 230, 60) })
		end)
	elseif kind == "Haste" then
		highlight(character, Color3.fromHex("#FFD700"), duration, 0.7)
		orbit(character, duration, 2, 2.2, -1.5, 12, function()
			return newPart({ Size = Vector3.new(0.3, 0.3, 2.5), Color = Color3.fromHex("#FFD700") })
		end)
	elseif kind == "Shield" then
		local bubble = newPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(8, 8, 8),
			Color = Color3.fromHex("#00BFFF"),
			Material = Enum.Material.ForceField,
			Transparency = 0.2,
		})
		local elapsed = 0
		addUpdater(function(dt)
			elapsed += dt
			local root = rootOf(character)
			local shield = character:GetAttribute("Shield") or 0
			-- เผื่อเวลาให้ attribute ซิงก์มาถึงก่อน แล้วค่อยเช็กว่าโล่แตกหรือยัง
			if elapsed >= duration or not root or (elapsed > 0.4 and shield <= 0) then
				bubble:Destroy()
				return false
			end
			bubble.Position = root.Position
			return true
		end)
	end
end

-- เรียกเอฟเฟกต์ตามชื่อ (ใช้โดย VFXController)
function VFX.Play(effectId, data)
	local handler = VFX[effectId]
	if type(handler) == "function" and type(data) == "table" then
		handler(data)
	end
end

return VFX
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="17">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="18">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[-- ดาเมจ, ใครฆ่าใคร, assist, ฟื้นเลือด — server เป็นคนตัดสินทั้งหมด
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Classes = require(Shared:WaitForChild("Classes"))

local StatusService = require(script.Parent.StatusService)
local StatsService = require(script.Parent.StatsService)

local CombatService = {}

local damageLogs = {} -- [character] = { [userId] = { Time, Skill, Player } }
local lastDamaged = {} -- [character] = os.clock()

local function getRoot(model)
	return model:FindFirstChild("HumanoidRootPart")
end

function CombatService.InLobby(model)
	local root = getRoot(model)
	return root ~= nil and root.Position.Y > Config.Lobby.SafeY
end

function CombatService.IsAlive(model)
	if not model or not model.Parent then
		return false
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0 and getRoot(model) ~= nil
end

function CombatService.LastDamaged(character)
	return lastDamaged[character] or 0
end

local function subclassColor(player)
	local sub = player and Classes.GetSubclass(player:GetAttribute("Subclass"))
	return sub and sub.Color or Color3.new(1, 1, 1)
end

function CombatService.Heal(character, amount)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + amount)
	end
end

-- ทำดาเมจ คืนค่าดาเมจที่เข้าเลือดจริง (0 = ไม่เข้า)
-- opts.NoReflect = ดาเมจสะท้อน/สวนกลับ (ห้ามสะท้อนซ้ำ)
function CombatService.Damage(attacker, target, amount, skillName, opts)
	opts = opts or {}
	if not CombatService.IsAlive(target) or amount <= 0 then
		return 0
	end
	if CombatService.InLobby(target) then
		return 0
	end
	local attackerChar = attacker and attacker.Character
	if attackerChar then
		if attackerChar == target or CombatService.InLobby(attackerChar) then
			return 0
		end
	end
	if attacker and target:GetAttribute("OwnerId") == attacker.UserId then
		return 0
	end
	if StatusService.IsInvulnerable(target) then
		return 0
	end

	local humanoid = target:FindFirstChildOfClass("Humanoid")
	local root = getRoot(target)
	local targetPlayer = Players:GetPlayerFromCharacter(target)

	-- ปัดป้อง (Perfect Parry): ไม่เสียเลือด + สวนกลับ 2 เท่า + Stun ผู้ตี
	local parry = StatusService.Get(target, "Parry")
	if parry then
		if opts.NoReflect then
			return 0
		end
		StatusService.Remove(target, "Parry")
		Remotes.PlayVFX:FireAllClients("Explosion", {
			Position = root.Position, Radius = 6, Color = Color3.fromHex("#FF8C00"), Duration = 0.3,
		})
		if attackerChar and CombatService.IsAlive(attackerChar) then
			CombatService.Damage(targetPlayer, attackerChar, amount * (parry.Multiplier or 2), "ปัดป้อง", { NoReflect = true })
			StatusService.Stun(attackerChar, parry.Stun or 1)
		end
		return 0
	end

	-- ร่างเงา (Shadow Veil): การโจมตีครั้งแรกแรงขึ้น
	if attackerChar and not opts.NoReflect then
		local empower = StatusService.Get(attackerChar, "Empower")
		if empower then
			amount *= empower.Bonus or 1.5
			StatusService.Remove(attackerChar, "Empower")
		end
	end

	-- ร่างปลอมนินจา: โดนตีครั้งเดียวหาย
	if target:GetAttribute("OneHit") then
		Remotes.PlayVFX:FireAllClients("Explosion", {
			Position = root.Position, Radius = 5, Color = Color3.fromRGB(200, 200, 200), Duration = 0.35,
		})
		target:Destroy()
		return 0
	end

	local remaining, reflect = StatusService.AbsorbShield(target, amount)
	if reflect and attackerChar and not opts.NoReflect then
		Remotes.PlayVFX:FireAllClients("Lightning", {
			From = root.Position, To = attackerChar:GetPivot().Position, Color = Color3.fromHex("#00BFFF"),
		})
		CombatService.Damage(targetPlayer, attackerChar, reflect, "โล่ไฟฟ้า", { NoReflect = true })
	end

	local now = os.clock()
	lastDamaged[target] = now
	if attacker then
		local log = damageLogs[target]
		if not log then
			log = {}
			damageLogs[target] = log
		end
		log[attacker.UserId] = { Time = now, Skill = skillName or "โจมตี", Player = attacker }
		Remotes.SkillFeedback:FireClient(attacker, {
			Type = "Damage",
			Position = root.Position,
			Amount = math.floor(amount + 0.5),
			Shielded = remaining < amount,
		})
	end
	Remotes.PlayVFX:FireAllClients("Hit", { Position = root.Position, Color = subclassColor(attacker) })

	if remaining <= 0 then
		return 0
	end

	local newHealth = humanoid.Health - remaining
	if targetPlayer then
		humanoid.Health = math.max(0, newHealth)
	elseif target:GetAttribute("Dummy") then
		-- หุ่นซ้อม: ไม่ตายจริง เลือดเต็มใหม่
		if newHealth <= 0 then
			humanoid.Health = humanoid.MaxHealth
			Remotes.PlayVFX:FireAllClients("Explosion", {
				Position = root.Position, Radius = 5, Color = Color3.fromRGB(255, 255, 255), Duration = 0.3,
			})
		else
			humanoid.Health = newHealth
		end
	else
		-- ป้อมปืน ฯลฯ
		if newHealth <= 0 then
			Remotes.PlayVFX:FireAllClients("Explosion", {
				Position = root.Position, Radius = 6, Color = Color3.fromRGB(255, 160, 60), Duration = 0.35,
			})
			target:Destroy()
		else
			humanoid.Health = newHealth
		end
	end
	return remaining
end

-- เรียกเมื่อผู้เล่นตาย (ทุกสาเหตุ) เพื่อให้เครดิตคิล / assist
function CombatService.HandleDeath(victim, character)
	local now = os.clock()
	local log = damageLogs[character] or {}
	damageLogs[character] = nil
	lastDamaged[character] = nil

	local killerEntry
	for _, entry in pairs(log) do
		if now - entry.Time <= Config.AssistWindow * 2 and entry.Player ~= victim then
			if not killerEntry or entry.Time > killerEntry.Time then
				killerEntry = entry
			end
		end
	end

	StatsService.AddDeath(victim)

	if not killerEntry then
		Remotes.KillFeed:FireAllClients(nil, victim.DisplayName, "ตกจากสนาม", {})
		return
	end

	local killer = killerEntry.Player
	local assists = {}
	for _, entry in pairs(log) do
		if entry ~= killerEntry and entry.Player ~= victim and now - entry.Time <= Config.AssistWindow then
			table.insert(assists, entry.Player.DisplayName)
		end
	end

	Remotes.KillFeed:FireAllClients(killer.DisplayName, victim.DisplayName, killerEntry.Skill, assists)

	if killer.Parent then
		local streak = StatsService.AddKill(killer)
		if killer.Character then
			CombatService.Heal(killer.Character, Config.KillHeal)
		end
		local message = Config.Streaks[streak]
		if message then
			Remotes.Announce:FireAllClients(
				string.format("%s %s (ฆ่าติดกัน %d ครั้ง)", killer.DisplayName, message, streak),
				subclassColor(killer)
			)
		end
	end
end

function CombatService.Init()
	-- ฟื้นเลือด 3 HP/วิ หลังไม่โดนตี 6 วิ
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			for _, player in ipairs(Players:GetPlayers()) do
				local character = player.Character
				if character and CombatService.IsAlive(character) then
					if now - (lastDamaged[character] or 0) >= Config.Regen.Delay then
						CombatService.Heal(character, Config.Regen.Rate)
					end
				end
			end
			for character in pairs(lastDamaged) do
				if not character.Parent then
					lastDamaged[character] = nil
					damageLogs[character] = nil
				end
			end
		end
	end)
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">LoadoutService</string>
          <string name="Source"><![CDATA[-- รับ / ตรวจสอบ / บันทึกการเลือกสายของผู้เล่น
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Classes = require(Shared:WaitForChild("Classes"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local SpawnService = require(script.Parent.SpawnService)

local LoadoutService = {}

local loadouts = {} -- [player] = { Subclass = string, Skills = { string×3 } }
local lastSelect = {}

local store
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[LoadoutService] ใช้ DataStore ไม่ได้ จะใช้ค่าเริ่มต้นแทน:", result)
	end
end

local function apply(player, subclassId, skills)
	loadouts[player] = { Subclass = subclassId, Skills = { skills[1], skills[2], skills[3] } }
	player:SetAttribute("Skill1", skills[1])
	player:SetAttribute("Skill2", skills[2])
	player:SetAttribute("Skill3", skills[3])
	player:SetAttribute("Subclass", subclassId)
end

function LoadoutService.Get(player)
	return loadouts[player]
end

local function save(player)
	local loadout = loadouts[player]
	if not store or not loadout then
		return
	end
	local userId = player.UserId
	task.spawn(function()
		local ok, err = pcall(function()
			store:SetAsync("u_" .. userId, { Subclass = loadout.Subclass, Skills = loadout.Skills })
		end)
		if not ok then
			warn("[LoadoutService] บันทึกชุดสกิลไม่สำเร็จ:", err)
		end
	end)
end

local function load(player)
	if not store then
		return
	end
	local ok, data = pcall(function()
		return store:GetAsync("u_" .. player.UserId)
	end)
	if not ok or type(data) ~= "table" then
		return
	end
	if not Classes.ValidateLoadout(data.Subclass, data.Skills) then
		return
	end
	-- ใช้ค่าที่บันทึกไว้เฉพาะตอนที่ผู้เล่นยังไม่ได้เลือกเองและยังอยู่ใน Lobby
	if player.Parent and not player:GetAttribute("InArena") and not player:GetAttribute("HasChosen") then
		apply(player, data.Subclass, data.Skills)
		player:SetAttribute("HasSaved", true)
	end
end

local function onSelect(player, subclassId, skills)
	local now = os.clock()
	if lastSelect[player] and now - lastSelect[player] < 0.5 then
		return
	end
	lastSelect[player] = now

	local function reject(reason)
		Remotes.SkillFeedback:FireClient(player, { Type = "LoadoutRejected", Reason = reason })
	end

	if player:GetAttribute("InArena") then
		return reject("ต้องอยู่ใน Lobby ถึงจะเปลี่ยนสายได้")
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return reject("ยังไม่พร้อมลงสนาม")
	end
	local ok, reason = Classes.ValidateLoadout(subclassId, skills)
	if not ok then
		return reject(reason)
	end

	apply(player, subclassId, skills)
	player:SetAttribute("HasChosen", true)
	save(player)

	if SpawnService.Deploy(player) then
		Remotes.SkillFeedback:FireClient(player, { Type = "LoadoutAccepted" })
	else
		reject("ยังไม่พร้อมลงสนาม")
	end
end

local function onPlayer(player)
	apply(player, Config.DefaultLoadout.Subclass, Config.DefaultLoadout.Skills)
	task.spawn(load, player)
end

function LoadoutService.Init()
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		loadouts[player] = nil
		lastSelect[player] = nil
	end)
	Remotes.SelectLoadout.OnServerEvent:Connect(onSelect)
end

return LoadoutService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="21">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- จุดเริ่มต้นฝั่ง server: สร้างแผนที่แล้วเปิดระบบทั้งหมดตามลำดับ
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Server = script.Parent

-- สร้าง RemoteEvent ทั้งหมดก่อน (client จะรอจนกว่าจะมี)
require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local MapBuilder = require(Server.MapBuilder)
local StatsService = require(Server.StatsService)
local CombatService = require(Server.CombatService)
local SpawnService = require(Server.SpawnService)
local LoadoutService = require(Server.LoadoutService)
local SkillService = require(Server.SkillService)

local mapInfo = MapBuilder.Build()

StatsService.Init()
CombatService.Init()
SpawnService.Init(mapInfo)
LoadoutService.Init()
SkillService.Init()

print("[QuantumArena] เซิร์ฟเวอร์พร้อมแล้ว")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[-- สร้างแผนที่ทั้งหมดด้วยโค้ดตอนเริ่มเซิร์ฟเวอร์ (ไม่ใช้ asset จาก Toolbox)
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local CombatService = require(script.Parent.CombatService)
local StatusService = require(script.Parent.StatusService)

local MapBuilder = {}

local FLOOR_COLOR = Color3.fromRGB(34, 36, 46)
local WALL_COLOR = Color3.fromRGB(48, 52, 66)
local NEON_CYAN = Color3.fromRGB(0, 200, 255)
local NEON_PINK = Color3.fromRGB(255, 60, 200)
local NEON_ORANGE = Color3.fromRGB(255, 150, 40)
local NEON_GREEN = Color3.fromRGB(80, 255, 140)

local function folder(name, parent)
	local existing = parent:FindFirstChild(name)
	if existing then
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function make(parent, props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in pairs(props) do
		part[key] = value
	end
	part.Parent = parent
	return part
end

-- ชิ้นตกแต่งนีออน: ไม่ชน ไม่รับ raycast
local function neon(parent, props)
	props.Material = Enum.Material.Neon
	props.CanCollide = false
	props.CanQuery = false
	props.CanTouch = false
	props.CastShadow = false
	return make(parent, props)
end

-- แผ่นกลมแนวนอน (Cylinder หมุนให้แกนตั้ง)
local function disc(parent, position, radius, height, props)
	props = props or {}
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(height, radius * 2, radius * 2)
	props.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	return make(parent, props)
end

local function polar(radius, degrees, y)
	local rad = math.rad(degrees)
	return Vector3.new(math.cos(rad) * radius, y or 0, math.sin(rad) * radius)
end

local function light(parent, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness or 1.5
	l.Parent = parent
	return l
end

---------------------------------------------------------------------------
-- แสง
---------------------------------------------------------------------------
local function buildLighting()
	Lighting.ClockTime = 0
	Lighting.Brightness = 1.5
	Lighting.Ambient = Color3.fromRGB(95, 95, 120)
	Lighting.OutdoorAmbient = Color3.fromRGB(80, 80, 110)
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.6

	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("PostEffect") or child:IsA("Atmosphere") then
			child:Destroy()
		end
	end

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(90, 80, 160)
	atmosphere.Decay = Color3.fromRGB(30, 20, 70)
	atmosphere.Glare = 0
	atmosphere.Haze = 1.2
	atmosphere.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.9
	bloom.Size = 28
	bloom.Threshold = 0.9
	bloom.Parent = Lighting

	local color = Instance.new("ColorCorrectionEffect")
	color.Contrast = 0.15
	color.Saturation = 0.2
	color.TintColor = Color3.fromRGB(235, 235, 255)
	color.Parent = Lighting
end

---------------------------------------------------------------------------
-- Lobby (แท่นลอย ปลอดภัย ตีกันไม่ได้)
---------------------------------------------------------------------------
local function buildLobby(map)
	local lobby = folder("Lobby", map)
	local center = Config.Lobby.Center
	local size = Config.Lobby.Size
	local half = size / 2

	make(lobby, {
		Name = "Floor",
		Size = Vector3.new(size, 2, size),
		Position = center - Vector3.new(0, 1, 0),
		Color = FLOOR_COLOR,
		Material = Enum.Material.Metal,
	})

	-- เส้นนีออนขอบพื้น + กำแพงกระจกกันตก
	for _, side in ipairs({
		{ Vector3.new(0, 0, half), Vector3.new(size, 0.3, 0.6), Vector3.new(size, 16, 1) },
		{ Vector3.new(0, 0, -half), Vector3.new(size, 0.3, 0.6), Vector3.new(size, 16, 1) },
		{ Vector3.new(half, 0, 0), Vector3.new(0.6, 0.3, size), Vector3.new(1, 16, size) },
		{ Vector3.new(-half, 0, 0), Vector3.new(0.6, 0.3, size), Vector3.new(1, 16, size) },
	}) do
		neon(lobby, { Name = "Edge", Size = side[2], Position = center + side[1] + Vector3.new(0, 0.1, 0), Color = NEON_CYAN })
		make(lobby, {
			Name = "Glass",
			Size = side[3],
			Position = center + side[1] + Vector3.new(0, 8, 0),
			Color = Color3.fromRGB(120, 200, 255),
			Material = Enum.Material.Glass,
			Transparency = 0.8,
		})
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.Position = center + Vector3.new(0, 0.5, 18)
	spawn.Material = Enum.Material.Neon
	spawn.Color = NEON_GREEN
	spawn.Transparency = 0.6
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = lobby

	-- ประตูนีออน: เดินเข้าไปเพื่อวาร์ปลงสนาม
	local gateZ = -half + 6
	neon(lobby, { Name = "GatePillar", Size = Vector3.new(1.5, 13, 1.5), Position = center + Vector3.new(-5.5, 6.5, gateZ), Color = NEON_PINK })
	neon(lobby, { Name = "GatePillar", Size = Vector3.new(1.5, 13, 1.5), Position = center + Vector3.new(5.5, 6.5, gateZ), Color = NEON_PINK })
	local top = neon(lobby, { Name = "GateTop", Size = Vector3.new(12.5, 1.5, 1.5), Position = center + Vector3.new(0, 13.5, gateZ), Color = NEON_PINK })
	light(top, NEON_PINK, 30, 2)

	local gate = make(lobby, {
		Name = "LobbyGate",
		Size = Vector3.new(9.5, 12.5, 1),
		Position = center + Vector3.new(0, 6.5, gateZ),
		Color = NEON_PINK,
		Material = Enum.Material.ForceField,
		Transparency = 0.3,
		CanCollide = false,
		CanQuery = false,
	})

	local gateGui = Instance.new("BillboardGui")
	gateGui.Size = UDim2.fromScale(14, 3)
	gateGui.StudsOffset = Vector3.new(0, 10, 0)
	gateGui.LightInfluence = 0
	gateGui.MaxDistance = 200
	local gateLabel = Instance.new("TextLabel")
	gateLabel.BackgroundTransparency = 1
	gateLabel.Size = UDim2.fromScale(1, 1)
	gateLabel.Font = Enum.Font.GothamBlack
	gateLabel.TextScaled = true
	gateLabel.TextColor3 = Color3.new(1, 1, 1)
	gateLabel.TextStrokeTransparency = 0.3
	gateLabel.Text = "⚔ ลงสนาม ⚔"
	gateLabel.Parent = gateGui
	gateGui.Parent = gate

	-- ป้ายบอกวิธีเล่น
	local sign = make(lobby, {
		Name = "HowToPlay",
		Size = Vector3.new(26, 14, 1),
		Position = center + Vector3.new(23, 8, gateZ),
		Color = Color3.fromRGB(18, 18, 28),
	})
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Back
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 30
	surface.LightInfluence = 0
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(0.94, 0.94)
	text.Position = UDim2.fromScale(0.03, 0.03)
	text.Font = Enum.Font.GothamBold
	text.TextScaled = true
	text.TextColor3 = Color3.fromRGB(230, 240, 255)
	text.TextXAlignment = Enum.TextXAlignment.Left
	text.TextYAlignment = Enum.TextYAlignment.Top
	text.Text = table.concat({
		"วิธีเล่น QUANTUM ARENA",
		"",
		"1. เลือกสายใหญ่ → สายย่อย → สกิล 3 จาก 5",
		"2. กด \"ลงสนาม\" หรือเดินเข้าประตูนีออน",
		"3. คลิกซ้าย = โจมตี   Q / E / R = สกิล",
		"4. Shift = พุ่งหลบ   Tab = กลับมาเปลี่ยนสาย",
		"5. ฆ่าได้ฟื้นเลือด 30 HP — สู้ให้สนุก!",
	}, "\n")
	text.Parent = surface
	surface.Parent = sign

	-- ไฟส่องป้ายและไฟกลาง Lobby
	local frame = neon(lobby, { Name = "SignFrame", Size = Vector3.new(27, 0.5, 1.2), Position = sign.Position + Vector3.new(0, 7.2, 0), Color = NEON_CYAN })
	light(frame, NEON_CYAN, 24, 1.5)
	local centerLight = neon(lobby, { Name = "LobbyLight", Size = Vector3.new(4, 0.4, 4), Position = center + Vector3.new(0, 22, 0), Color = Color3.new(1, 1, 1), Transparency = 0.3 })
	light(centerLight, Color3.fromRGB(220, 220, 255), 60, 1.5)

	return gate
end

---------------------------------------------------------------------------
-- Arena
---------------------------------------------------------------------------
local function buildArena(map)
	local arena = folder("Arena", map)
	local radius = Config.Arena.Radius

	disc(arena, Vector3.new(0, -2, 0), radius, 4, { Name = "Floor", Color = FLOOR_COLOR, Material = Enum.Material.Metal })

	-- เส้นนีออนเป็นตาราง
	local gridFolder = folder("Grid", arena)
	local inner = radius - 2
	for offset = -120, 120, 30 do
		local halfLength = math.sqrt(inner * inner - offset * offset)
		neon(gridFolder, { Name = "GridX", Size = Vector3.new(0.35, 0.1, halfLength * 2), Position = Vector3.new(offset, 0.05, 0), Color = NEON_CYAN, Transparency = 0.35 })
		neon(gridFolder, { Name = "GridZ", Size = Vector3.new(halfLength * 2, 0.1, 0.35), Position = Vector3.new(0, 0.05, offset), Color = NEON_CYAN, Transparency = 0.35 })
	end

	-- ขอบสนาม: วงนีออน + กำแพงพลังงานล่องหน
	local segments = 40
	local segmentLength = 2 * math.pi * (radius + 1) / segments + 1
	for i = 1, segments do
		local angle = (i - 1) * 360 / segments
		local position = polar(radius - 0.5, angle, 0.3)
		neon(arena, {
			Name = "Rim",
			Size = Vector3.new(segmentLength, 0.6, 1),
			CFrame = CFrame.lookAt(position, Vector3.new(0, 0.3, 0)),
			Color = NEON_PINK,
		})
		local wallPos = polar(radius + 1, angle, 60)
		make(arena, {
			Name = "Barrier",
			Size = Vector3.new(segmentLength, 124, 2),
			CFrame = CFrame.lookAt(wallPos, Vector3.new(0, 60, 0)),
			Transparency = 1,
			CastShadow = false,
		})
	end

	-- กำแพงกำบังวงนอก 8 ชิ้น + เสาวงใน 8 ต้น (สมมาตร)
	for i = 0, 7 do
		local wallPos = polar(110, i * 45, 5.5)
		local wall = make(arena, {
			Name = "CoverWall",
			Size = Vector3.new(18, 11, 2.5),
			CFrame = CFrame.lookAt(wallPos, Vector3.new(0, 5.5, 0)),
			Color = WALL_COLOR,
			Material = Enum.Material.Metal,
		})
		neon(arena, {
			Name = "CoverTrim",
			Size = Vector3.new(18.2, 0.5, 2.7),
			CFrame = wall.CFrame * CFrame.new(0, 5.3, 0),
			Color = i % 2 == 0 and NEON_CYAN or NEON_PINK,
		})

		local pillarPos = polar(68, i * 45 + 22.5, 7)
		make(arena, {
			Name = "Pillar",
			Size = Vector3.new(5, 14, 5),
			CFrame = CFrame.lookAt(pillarPos, Vector3.new(0, 7, 0)),
			Color = WALL_COLOR,
			Material = Enum.Material.Metal,
		})
		local band = neon(arena, {
			Name = "PillarBand",
			Size = Vector3.new(5.3, 0.6, 5.3),
			CFrame = CFrame.lookAt(pillarPos + Vector3.new(0, 4, 0), Vector3.new(0, 11, 0)),
			Color = i % 2 == 0 and NEON_PINK or NEON_CYAN,
		})
		light(band, band.Color, 28, 1.2)
	end

	-- แท่นสูง 3 ระดับตรงกลาง
	local tiers = { { Radius = 30, Top = 4 }, { Radius = 20, Top = 8 }, { Radius = 10, Top = 12 } }
	for index, tier in ipairs(tiers) do
		disc(arena, Vector3.new(0, tier.Top - 2, 0), tier.Radius, 4, {
			Name = "Tier" .. index,
			Color = Color3.fromRGB(42 + index * 6, 46 + index * 6, 60 + index * 8),
			Material = Enum.Material.Metal,
		})
		local rim = disc(arena, Vector3.new(0, tier.Top - 0.12, 0), tier.Radius + 0.25, 0.2, {
			Name = "TierRim",
			Color = index == 3 and NEON_ORANGE or NEON_CYAN,
		})
		rim.Material = Enum.Material.Neon
		rim.CanCollide = false
		rim.CanQuery = false
		rim.CastShadow = false
	end
	local beacon = neon(arena, { Name = "Beacon", Size = Vector3.new(1, 0.3, 1), Position = Vector3.new(0, 12.2, 0), Color = NEON_ORANGE })
	light(beacon, NEON_ORANGE, 50, 2)

	-- ทางลาดขึ้นแท่น
	local function ramp(angle, bottomRadius, bottomY, topRadius, topY)
		local bottom = polar(bottomRadius, angle, bottomY)
		local top = polar(topRadius, angle, topY)
		local mid = (bottom + top) / 2
		make(arena, {
			Name = "Ramp",
			Size = Vector3.new(9, 1, (top - bottom).Magnitude + 1),
			CFrame = CFrame.lookAt(mid, top) * CFrame.new(0, -0.5, 0),
			Color = Color3.fromRGB(60, 64, 84),
			Material = Enum.Material.DiamondPlate,
		})
	end
	for i = 0, 3 do
		ramp(i * 90, 43, 0, 30, 4)
		ramp(i * 90 + 45, 30, 4, 20, 8)
		ramp(i * 90, 20, 8, 10, 12)
	end

	-- Jump pad 4 จุด ดีดขึ้นแท่นสูง
	local padDebounce = {}
	for i = 0, 3 do
		local angle = i * 90 + 45
		local position = polar(54, angle, 0.2)
		local pad = disc(arena, position, 4.5, 0.4, { Name = "JumpPad", Color = NEON_ORANGE, CanCollide = false })
		pad.Material = Enum.Material.Neon
		light(pad, NEON_ORANGE, 18, 1.5)
		local inward = -polar(1, angle, 0)
		pad.Touched:Connect(function(hit)
			local character = hit.Parent
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if not humanoid or humanoid.Health <= 0 or not character:FindFirstChild("HumanoidRootPart") then
				return
			end
			local now = os.clock()
			if padDebounce[character] and now - padDebounce[character] < 1 then
				return
			end
			padDebounce[character] = now
			if StatusService.CanAct(character) then
				StatusService.Push(character, inward * 45 + Vector3.new(0, 45, 0), 0.3)
			end
		end)
	end
	task.spawn(function()
		while true do
			task.wait(10)
			for character in pairs(padDebounce) do
				if not character.Parent then
					padDebounce[character] = nil
				end
			end
		end
	end)

	-- จุดเกิดในสนาม 8 จุดรอบขอบ
	local spawns = {}
	for i = 0, Config.Arena.SpawnCount - 1 do
		local angle = i * (360 / Config.Arena.SpawnCount) + 22.5
		local ground = polar(Config.Arena.SpawnRadius, angle, 0)
		table.insert(spawns, ground + Vector3.new(0, 4, 0))
		local marker = disc(arena, ground + Vector3.new(0, 0.1, 0), 4, 0.2, { Name = "SpawnPad", Color = NEON_GREEN, Transparency = 0.5, CanCollide = false })
		marker.Material = Enum.Material.Neon
		marker.CanQuery = false
		marker.CanTouch = false
	end

	return spawns
end

---------------------------------------------------------------------------
-- หุ่นซ้อม (ไว้ทดสอบสกิลคนเดียว)
---------------------------------------------------------------------------
local function buildDummies()
	local entities = folder("Entities", Workspace)
	for i = 0, 3 do
		local base = polar(88, i * 90, 0)
		local facing = CFrame.lookAt(base, Vector3.new(0, 0, 0))
		local model = Instance.new("Model")
		model.Name = "หุ่นซ้อม"

		local function piece(name, size, offset, color)
			return make(model, {
				Name = name,
				Size = size,
				CFrame = facing * CFrame.new(offset),
				Color = color,
				Material = Enum.Material.Metal,
			})
		end
		piece("Legs", Vector3.new(2, 2, 1), Vector3.new(0, 1, 0), Color3.fromRGB(60, 60, 75))
		local root = piece("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), Color3.fromRGB(200, 200, 210))
		local head = piece("Head", Vector3.new(1.4, 1.4, 1.4), Vector3.new(0, 4.7, 0), Color3.fromRGB(255, 200, 80))
		head.Shape = Enum.PartType.Ball
		model.PrimaryPart = root

		local humanoid = Instance.new("Humanoid")
		humanoid.RequiresNeck = false
		humanoid.BreakJointsOnDeath = false
		humanoid.MaxHealth = Config.MaxHealth
		humanoid.Health = Config.MaxHealth
		humanoid.DisplayName = "หุ่นซ้อม"
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOn
		humanoid.Parent = model

		model:SetAttribute("Dummy", true)
		CollectionService:AddTag(model, "QA_Combatant")
		model.Parent = entities
	end

	-- หุ่นซ้อมฟื้นเลือดเองเมื่อไม่โดนตี 4 วิ
	task.spawn(function()
		while true do
			task.wait(1)
			for _, model in ipairs(entities:GetChildren()) do
				if model:GetAttribute("Dummy") and os.clock() - CombatService.LastDamaged(model) > 4 then
					local humanoid = model:FindFirstChildOfClass("Humanoid")
					if humanoid then
						humanoid.Health = humanoid.MaxHealth
					end
				end
			end
		end
	end)
end

function MapBuilder.Build()
	local map = folder("Map", Workspace)
	folder("Effects", Workspace)
	buildLighting()
	local gate = buildLobby(map)
	local spawns = buildArena(map)
	buildDummies()
	return { ArenaSpawns = spawns, LobbyGate = gate }
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="23">
        <Properties>
          <string name="Name">SkillHandlers</string>
        </Properties>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Basic</string>
            <string name="Source"><![CDATA[-- โจมตีปกติของทุกสายย่อย (เลือกวิธีตาม Basic.Type ใน SkillData)
local Server = script.Parent.Parent
local CombatService = require(Server.CombatService)
local StatusService = require(Server.StatusService)
local U = require(Server.SkillUtil)

local Basic = {}

local combos = {} -- [player] = { Index, Last }
local guns = {} -- [player] = { Ammo, ReloadUntil }

local COMBO_RESET = 1.2

local function gunState(player, basic)
	local state = guns[player]
	if not state then
		state = { Ammo = basic.Ammo, ReloadUntil = 0 }
		guns[player] = state
		player:SetAttribute("Ammo", state.Ammo)
		player:SetAttribute("Reloading", false)
	end
	return state
end

function Basic.Reset(player, basic)
	combos[player] = nil
	guns[player] = nil
	player:SetAttribute("Ammo", nil)
	player:SetAttribute("Reloading", nil)
	if basic and basic.Type == "Gun" then
		gunState(player, basic)
	end
end

function Basic.Cleanup(player)
	combos[player] = nil
	guns[player] = nil
end

function Basic.CanUse(player, _character, basic)
	if basic.Type == "Gun" then
		return os.clock() >= gunState(player, basic).ReloadUntil
	end
	return true
end

function Basic.GetCooldown(_player, character, basic)
	if basic.Type == "Gun" and StatusService.Has(character, "Overdrive") then
		return basic.Cooldown / 2
	end
	return basic.Cooldown
end

local Types = {}

function Types.Projectile(player, _character, p)
	local basic = p.Skill
	U.Projectile(player, {
		Origin = p.Origin + p.Direction * 2,
		Direction = p.Direction,
		Speed = basic.Speed,
		Range = basic.Range,
		Radius = basic.Radius,
		Visual = { Color = p.Color, Size = 1.4, Style = "Orb" },
		OnHit = function(model)
			CombatService.Damage(player, model, basic.Damage, p.Name)
		end,
	})
end

function Types.Spread(player, _character, p)
	local basic = p.Skill
	for i = 1, basic.Count do
		local angle = (i - (basic.Count + 1) / 2) * basic.SpreadAngle
		local direction = U.Rotate(p.Direction, angle)
		U.Projectile(player, {
			Origin = p.Origin + direction * 2,
			Direction = direction,
			Speed = basic.Speed,
			Range = basic.Range,
			Radius = basic.Radius,
			Visual = { Color = p.Color, Size = 0.7, Style = "Needle" },
			OnHit = function(model)
				CombatService.Damage(player, model, basic.Damage, p.Name)
			end,
		})
	end
end

function Types.Hitscan(player, _character, p)
	local basic = p.Skill
	local target, position = U.Hitscan(player, p.Origin, p.Direction, basic.Range, basic.Radius)
	U.VFX("Lightning", { From = p.Origin + p.Direction * 2, To = position, Color = p.Color, Width = 0.35 })
	if target then
		CombatService.Damage(player, target, basic.Damage, p.Name)
	end
end

function Types.Gun(player, character, p)
	local basic = p.Skill
	local state = gunState(player, basic)
	local overdrive = StatusService.Has(character, "Overdrive")
	if not overdrive then
		state.Ammo -= 1
		player:SetAttribute("Ammo", state.Ammo)
	end

	local target, position = U.Hitscan(player, p.Origin, p.Direction, basic.Range, basic.Radius)
	U.VFX("Beam", { From = p.Origin + p.Direction * 2.5, To = position, Color = p.Color, Width = 0.3, Duration = 0.12 })
	if target then
		CombatService.Damage(player, target, basic.Damage, p.Name)
	end

	if state.Ammo <= 0 then
		-- กระสุนหมด: รีโหลด
		state.ReloadUntil = os.clock() + basic.Reload
		player:SetAttribute("Reloading", true)
		task.delay(basic.Reload, function()
			if guns[player] == state then
				state.Ammo = basic.Ammo
				player:SetAttribute("Ammo", state.Ammo)
				player:SetAttribute("Reloading", false)
			end
		end)
	end
end

function Types.MeleeCombo(player, _character, p)
	local basic = p.Skill
	local now = os.clock()
	local combo = combos[player]
	if not combo or now - combo.Last > COMBO_RESET then
		combo = { Index = 0, Last = now }
		combos[player] = combo
	end
	combo.Index = combo.Index % #basic.Damage + 1
	combo.Last = now

	local damage = basic.Damage[combo.Index]
	local final = #basic.Damage > 1 and combo.Index == #basic.Damage
	local direction = p.Direction
	U.VFX("Slash", {
		Position = p.Origin,
		Direction = direction,
		Range = basic.Range,
		Width = basic.Width,
		Color = p.Color,
		Final = final,
		Flip = combo.Index % 2 == 0,
	})
	local enemies = U.EnemiesInLine(player, p.Origin - direction, direction, basic.Range + 1, basic.Width, 8)
	for _, model in ipairs(enemies) do
		CombatService.Damage(player, model, damage, p.Name)
	end
end

function Basic.Use(player, character, payload)
	local handler = Types[payload.Skill.Type]
	if handler then
		handler(player, character, payload)
	end
end

return Basic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Dimension</string>
            <string name="Source"><![CDATA[-- สกิลสายมิติ (Dimension)
local Server = script.Parent.Parent
local CombatService = require(Server.CombatService)
local StatusService = require(Server.StatusService)
local U = require(Server.SkillUtil)

local Debris = game:GetService("Debris")

local H = {}

-- วาร์ปไปตามทิศ สูงสุดตามระยะของสกิล ห้ามทะลุกำแพง
H.Blink = function(_player, character, p)
	local direction = U.Flat(p.Direction)
	if direction.Magnitude < 0.05 then
		direction = U.Flat(character:GetPivot().LookVector)
	end
	direction = direction.Unit
	local wanted = math.clamp(U.Flat(p.Point - p.Origin).Magnitude, 10, p.Skill.Range)
	local distance = U.ClampMove(p.Origin, direction, wanted)
	local destination = p.Origin + direction * distance
	U.VFX("Explosion", { Position = p.Origin, Radius = 4, Color = p.Color, Duration = 0.3 })
	U.Teleport(character, destination, direction)
	U.VFX("Beam", { From = p.Origin, To = destination, Color = p.Color, Width = 0.6, Duration = 0.25 })
	U.VFX("Explosion", { Position = destination, Radius = 5, Color = p.Color, Duration = 0.35 })
end

local function makePortal(position, color)
	local part = Instance.new("Part")
	part.Name = "QA_Portal"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(7, 7, 7)
	part.Position = position
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = true
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = 0.45
	part.CastShadow = false
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 16
	light.Brightness = 2
	light.Parent = part
	local core = Instance.new("ParticleEmitter")
	core.Color = ColorSequence.new(color)
	core.LightEmission = 1
	core.Rate = 25
	core.Lifetime = NumberRange.new(0.5, 0.9)
	core.Speed = NumberRange.new(2, 5)
	core.SpreadAngle = Vector2.new(180, 180)
	core.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) })
	core.Parent = part
	part.Parent = U.EffectsFolder()
	return part
end

-- ประตู 2 บาน ใครก็เดินผ่านได้
H.Portal = function(_player, _character, p)
	local flat = U.Flat(p.Direction)
	flat = flat.Magnitude > 0.05 and flat.Unit or Vector3.new(0, 0, -1)
	local near = p.Origin + flat * U.ClampMove(p.Origin, flat, 7)
	local far = p.Point + Vector3.new(0, 3.5, 0)
	local a = makePortal(near, p.Color)
	local b = makePortal(far, p.Color)
	Debris:AddItem(a, p.Skill.Duration)
	Debris:AddItem(b, p.Skill.Duration)

	local lastUse = {}
	local function link(from, to)
		from.Touched:Connect(function(hit)
			local model = U.ModelFromPart(hit)
			local root = model and U.Root(model)
			if not root or root.Anchored or not CombatService.IsAlive(model) then
				return
			end
			if not to.Parent then
				return
			end
			local now = os.clock()
			if lastUse[model] and now - lastUse[model] < 1.5 then
				return
			end
			lastUse[model] = now
			U.Teleport(model, to.Position, model:GetPivot().LookVector)
			U.VFX("Explosion", { Position = to.Position, Radius = 5, Color = p.Color, Duration = 0.3 })
		end)
	end
	link(a, b)
	link(b, a)
end

-- ทรงกลมดูดศัตรูเข้ากลาง
H.BlackHole = function(player, _character, p)
	local skill = p.Skill
	local center = p.Point + Vector3.new(0, 4, 0)
	U.VFX("Zone", { Position = center, Radius = skill.Radius, Color = p.Color, Duration = skill.Duration, Kind = "BlackHole" })
	local step = 0.1
	local ticks = math.floor(skill.Duration / step + 0.5)
	local perDamage = math.floor(skill.Tick / step + 0.5)
	for i = 1, ticks do
		for _, model in ipairs(U.EnemiesInRadius(player, center, skill.Radius)) do
			local offset = U.Flat(center - U.Position(model))
			if offset.Magnitude > 2 then
				StatusService.Knockback(model, offset.Unit * 26, step + 0.08)
			end
			if i % perDamage == 0 then
				CombatService.Damage(player, model, skill.Damage, p.Name)
			end
		end
		task.wait(step)
	end
end

-- รอยแยกเส้นตรง ระเบิดหลังดีเลย์
H.SpaceRift = function(player, _character, p)
	local skill = p.Skill
	local direction = U.Flat(p.Direction).Unit
	local from = p.Origin
	local to = from + direction * skill.Range
	U.VFX("LineTelegraph", { From = from, To = to, Width = skill.Width, Color = p.Color, Duration = skill.Delay })
	task.wait(skill.Delay)
	U.VFX("Beam", { From = from, To = to, Color = p.Color, Width = skill.Width * 0.8, Duration = 0.35 })
	for _, model in ipairs(U.EnemiesInLine(player, from, direction, skill.Range, skill.Width, 12)) do
		CombatService.Damage(player, model, skill.Damage, p.Name)
	end
end

-- อมตะ + ทะลุตัวคนอื่น แต่โจมตีไม่ได้
H.PhaseShift = function(_player, character, p)
	StatusService.Apply(character, "Phase", p.Skill.Duration)
	U.VFX("Aura", { Target = character, Color = p.Color, Duration = p.Skill.Duration, Kind = "Phase" })
end

return H
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">DivineFist</string>
            <string name="Source"><![CDATA[-- สกิลสายหมัดเทพ (Divine Fist)
local Server = script.Parent.Parent
local CombatService = require(Server.CombatService)
local StatusService = require(Server.StatusService)
local U = require(Server.SkillUtil)

local H = {}

-- หมัดส่งคลื่นลม + Knockback แรง
H.ShockwavePunch = function(player, _character, p)
	local skill = p.Skill
	local push = U.Flat(p.Direction)
	push = push.Magnitude > 0.05 and push.Unit or Vector3.new(0, 0, -1)
	U.VFX("Slash", { Position = p.Origin, Direction = p.Direction, Range = 6, Width = 6, Color = p.Color, Final = true })
	U.Projectile(player, {
		Origin = p.Origin + p.Direction * 2,
		Direction = p.Direction,
		Speed = skill.Speed,
		Range = skill.Range,
		Radius = skill.Radius,
		Pierce = true,
		Visual = { Color = p.Color, Size = skill.Radius * 2, Style = "Wave" },
		OnHit = function(model)
			if CombatService.Damage(player, model, skill.Damage, p.Name) > 0 then
				StatusService.Knockback(model, push * skill.Knockback + Vector3.new(0, 18, 0), 0.3)
			end
		end,
	})
end

-- รัวหมัด 10 ครั้งใน 1.5 วิ
H.HundredFists = function(player, character, p)
	local skill = p.Skill
	local interval = skill.Duration / skill.Hits
	StatusService.Apply(character, "Channel", skill.Duration)
	for i = 1, skill.Hits do
		if not CombatService.IsAlive(character) or not StatusService.CanAct(character) then
			break
		end
		local origin = U.Position(character)
		-- ต่อยไปทางที่ตัวละครหันอยู่ (เดินตามเป้าได้)
		local direction = U.Flat(character:GetPivot().LookVector)
		direction = direction.Magnitude > 0.05 and direction.Unit or p.Direction
		U.VFX("Slash", {
			Position = origin,
			Direction = direction,
			Range = skill.Range,
			Width = skill.Width,
			Color = p.Color,
			Flip = i % 2 == 0,
			Small = true,
		})
		for _, model in ipairs(U.EnemiesInLine(player, origin - direction, direction, skill.Range + 1, skill.Width, 8)) do
			CombatService.Damage(player, model, skill.Damage, p.Name)
		end
		task.wait(interval)
	end
	StatusService.Remove(character, "Channel")
end

-- ส่งศัตรูลอย ตัวเองกระโดดตาม
H.SkyUppercut = function(player, character, p)
	local skill = p.Skill
	local direction = U.Flat(p.Direction)
	direction = direction.Magnitude > 0.05 and direction.Unit or Vector3.new(0, 0, -1)
	U.VFX("Beam", {
		From = p.Origin + direction * 3 - Vector3.new(0, 2, 0),
		To = p.Origin + direction * 3 + Vector3.new(0, 12, 0),
		Color = p.Color,
		Width = 2,
		Duration = 0.3,
	})
	local hitAny = false
	for _, model in ipairs(U.EnemiesInLine(player, p.Origin - direction, direction, skill.Range + 1, skill.Width, 9)) do
		if CombatService.Damage(player, model, skill.Damage, p.Name) > 0 then
			StatusService.Airborne(model, skill.Airborne, 50)
			hitAny = true
		end
	end
	if hitAny then
		StatusService.Push(character, Vector3.new(0, 50, 0), 0.3)
	else
		StatusService.Push(character, Vector3.new(0, 35, 0), 0.2)
	end
end

-- กระโดดขึ้นแล้วทุบลง + Stun
H.GroundSlam = function(player, character, p)
	local skill = p.Skill
	StatusService.Apply(character, "Channel", 0.8)
	StatusService.Push(character, Vector3.new(0, 42, 0), 0.2)
	task.wait(0.75)
	if not CombatService.IsAlive(character) then
		return
	end
	local position = U.Position(character)
	local ground = U.GroundBelow(position, 40) or position
	U.VFX("Explosion", { Position = ground, Radius = skill.Radius, Color = p.Color, Duration = 0.45 })
	U.VFX("Telegraph", { Position = ground, Radius = skill.Radius, Color = p.Color, Duration = 0.3 })
	for _, model in ipairs(U.EnemiesInRadius(player, ground + Vector3.new(0, 2, 0), skill.Radius)) do
		if CombatService.Damage(player, model, skill.Damage, p.Name) > 0 then
			StatusService.Stun(model, skill.Stun)
		end
	end
end

-- ท่าตั้งรับ: CombatService จะสวนกลับให้เองถ้าโดนตีในช่วงนี้
H.PerfectParry = function(_player, character, p)
	local skill = p.Skill
	StatusService.Apply(character, "Parry", skill.Duration, { Multiplier = skill.Multiplier, Stun = skill.Stun })
	U.VFX("Aura", { Target = character, Color = p.Color, Duration = skill.Duration, Kind = "Parry" })
end

return H
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">EnergyGun</string>
            <string name="Source"><![CDATA[-- สกิลสายปืนพลังงาน (Energy Gun)
local Server = script.Parent.Parent
local CombatService = require(Server.CombatService)
local StatusService = require(Server.StatusService)
local U = require(Server.SkillUtil)

local CollectionService = game:GetService("CollectionService")

local H = {}

H.Overdrive = function(_player, character, p)
	StatusService.Apply(character, "Overdrive", p.Skill.Duration)
	U.VFX("Aura", { Target = character, Color = p.Color, Duration = p.Skill.Duration, Kind = "Overdrive" })
end

-- ชาร์จแล้วยิงเส้นทะลุทุกอย่าง
H.Railgun = function(player, character, p)
	local skill = p.Skill
	local direction = p.Direction
	StatusService.Apply(character, "Channel", skill.Charge)
	StatusService.Apply(character, "Rooted", skill.Charge)
	U.VFX("LineTelegraph", {
		From = p.Origin,
		To = p.Origin + direction * skill.Range,
		Width = 1.2,
		Color = p.Color,
		Duration = skill.Charge,
	})
	U.VFX("Aura", { Target = character, Color = p.Color, Duration = skill.Charge, Kind = "Charge" })
	task.wait(skill.Charge)
	if not CombatService.IsAlive(character) or not StatusService.CanAct(character) then
		return
	end
	local origin = U.Position(character)
	U.VFX("Beam", { From = origin, To = origin + direction * skill.Range, Color = p.Color, Width = 2.5, Duration = 0.4 })
	for _, model in ipairs(U.EnemiesInLine(player, origin, direction, skill.Range, skill.Width, 8)) do
		CombatService.Damage(player, model, skill.Damage, p.Name)
	end
end

-- ปาวิถีโค้ง ระเบิด + กระเด็น
H.PlasmaGrenade = function(player, _character, p)
	local skill = p.Skill
	local point = p.Point
	U.VFX("Arc", { From = p.Origin, To = point, Duration = skill.FlightTime, Color = p.Color, Size = 1.6 })
	U.VFX("Telegraph", { Position = point, Radius = skill.Radius, Color = p.Color, Duration = skill.FlightTime })
	task.wait(skill.FlightTime)
	U.VFX("Explosion", { Position = point, Radius = skill.Radius, Color = p.Color, Duration = 0.45 })
	for _, model in ipairs(U.EnemiesInRadius(player, point + Vector3.new(0, 2, 0), skill.Radius)) do
		local position = U.Position(model)
		if CombatService.Damage(player, model, skill.Damage, p.Name) > 0 and position then
			local away = U.Flat(position - point)
			away = away.Magnitude > 0.1 and away.Unit or Vector3.new(1, 0, 0)
			StatusService.Knockback(model, away * 50 + Vector3.new(0, 25, 0), 0.25)
		end
	end
end

-- ลูกซอง 8 นัดในกรวย + ดีดตัวเองถอยหลัง
H.ScatterBlast = function(player, character, p)
	local skill = p.Skill
	local origin = p.Origin
	for i = 1, skill.Hits do
		local angle = -skill.Cone / 2 + skill.Cone * (i - 1) / (skill.Hits - 1)
		local direction = U.Rotate(p.Direction, angle)
		local target, position = U.Hitscan(player, origin, direction, skill.Range, 0.8)
		U.VFX("Beam", { From = origin + direction * 2, To = position, Color = p.Color, Width = 0.25, Duration = 0.12 })
		if target then
			CombatService.Damage(player, target, skill.Damage, p.Name)
		end
	end
	local back = U.Flat(p.Direction)
	if back.Magnitude > 0.05 then
		StatusService.Push(character, -back.Unit * 55, 0.2)
	end
end

local function buildTurret(player, position, color, health)
	local model = Instance.new("Model")
	model.Name = "ป้อมปืน"

	local function part(name, size, offset, partColor, material)
		local piece = Instance.new("Part")
		piece.Name = name
		piece.Size = size
		piece.CFrame = CFrame.new(position + offset)
		piece.Anchored = true
		piece.CanCollide = true
		piece.Color = partColor
		piece.Material = material
		piece.Parent = model
		return piece
	end

	local dark = Color3.fromRGB(35, 35, 45)
	part("Base", Vector3.new(3.5, 1, 3.5), Vector3.new(0, 0.5, 0), dark, Enum.Material.Metal)
	local root = part("HumanoidRootPart", Vector3.new(2, 2, 2), Vector3.new(0, 2, 0), dark, Enum.Material.Metal)
	part("Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 3.6, 0), color, Enum.Material.Neon)
	model.PrimaryPart = root

	local humanoid = Instance.new("Humanoid")
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.MaxHealth = health
	humanoid.Health = health
	humanoid.DisplayName = "ป้อมปืน"
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOn
	humanoid.Parent = model

	model:SetAttribute("OwnerId", player.UserId)
	CollectionService:AddTag(model, U.COMBATANT_TAG)
	model.Parent = U.EntitiesFolder()
	return model
end

-- ป้อมยิงศัตรูใกล้สุดอัตโนมัติ
H.Turret = function(player, _character, p)
	local skill = p.Skill
	local flat = U.Flat(p.Direction)
	flat = flat.Magnitude > 0.05 and flat.Unit or Vector3.new(0, 0, -1)
	local spot = p.Origin + flat * U.ClampMove(p.Origin, flat, 5)
	local ground = U.GroundBelow(spot) or (spot - Vector3.new(0, 3, 0))
	local turret = buildTurret(player, ground, p.Color, skill.Health)
	local muzzle = ground + Vector3.new(0, 3.6, 0)
	U.VFX("Explosion", { Position = muzzle, Radius = 4, Color = p.Color, Duration = 0.3 })

	local shots = math.floor(skill.Duration / skill.FireRate)
	for _ = 1, shots do
		task.wait(skill.FireRate)
		if not turret.Parent or not player.Parent then
			break
		end
		local best, bestDist
		for _, model in ipairs(U.AllCombatants()) do
			if U.IsEnemy(player, model) then
				local position = U.Position(model)
				local dist = (position - muzzle).Magnitude
				if dist <= skill.Range and (not bestDist or dist < bestDist) and U.HasLineOfSight(muzzle, position) then
					best, bestDist = model, dist
				end
			end
		end
		if best then
			U.VFX("Beam", { From = muzzle, To = U.Position(best), Color = p.Color, Width = 0.25, Duration = 0.12 })
			CombatService.Damage(player, best, skill.Damage, p.Name)
		end
	end
	if turret.Parent then
		U.VFX("Explosion", { Position = muzzle, Radius = 4, Color = p.Color, Duration = 0.3 })
		turret:Destroy()
	end
end

return H
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Lightning</string>
            <string name="Source"><![CDATA[-- สกิลสายสายฟ้า (Lightning)
local Server = script.Parent.Parent
local CombatService = require(Server.CombatService)
local StatusService = require(Server.StatusService)
local U = require(Server.SkillUtil)

local H = {}

H.Bolt = function(player, _character, p)
	local skill = p.Skill
	U.Projectile(player, {
		Origin = p.Origin + p.Direction * 2,
		Direction = p.Direction,
		Speed = skill.Speed,
		Range = skill.Range,
		Radius = 1.3,
		Pierce = skill.Pierce,
		Visual = { Color = p.Color, Size = 1.2, Style = "Bolt" },
		OnHit = function(model)
			CombatService.Damage(player, model, skill.Damage, p.Name)
		end,
	})
end

H.FlashStep = function(player, character, p)
	local skill = p.Skill
	local from, to, distance = U.Dash(character, p.Direction, skill.Range, 0.16)
	U.VFX("Lightning", { From = from, To = to, Color = p.Color, Width = 0.8 })
	U.VFX("Dash", { From = from, To = to, Color = p.Color, Target = character })
	if distance > 0.5 then
		local direction = (to - from).Unit
		for _, model in ipairs(U.EnemiesInLine(player, from, direction, distance + 3, skill.Width, 9)) do
			CombatService.Damage(player, model, skill.Damage, p.Name)
		end
	end
end

H.ThunderStrike = function(player, _character, p)
	local skill = p.Skill
	local point = p.Point
	U.VFX("Telegraph", { Position = point, Radius = skill.Radius, Color = p.Color, Duration = skill.Delay })
	task.wait(skill.Delay)
	U.VFX("Lightning", { From = point + Vector3.new(0, 90, 0), To = point, Color = p.Color, Width = 2.5 })
	U.VFX("Explosion", { Position = point, Radius = skill.Radius, Color = p.Color, Duration = 0.4 })
	for _, model in ipairs(U.EnemiesInRadius(player, point + Vector3.new(0, 2, 0), skill.Radius)) do
		if CombatService.Damage(player, model, skill.Damage, p.Name) > 0 then
			StatusService.Stun(model, skill.Stun)
		end
	end
end

H.StaticShield = function(_player, character, p)
	StatusService.Shield(character, p.Skill.Shield, p.Skill.Duration, p.Skill.Damage)
end

H.ChainLightning = function(player, _character, p)
	local skill = p.Skill
	local target, position = U.Hitscan(player, p.Origin, p.Direction, skill.Range, 1.6)
	U.VFX("Lightning", { From = p.Origin + p.Direction * 2, To = position, Color = p.Color, Width = 0.6 })
	if not target then
		return
	end
	local hit = {}
	local damage = skill.Damage
	local jumps = 0
	while target do
		hit[target] = true
		local from = U.Position(target)
		CombatService.Damage(player, target, damage, p.Name)
		if jumps >= skill.Jumps or not from then
			break
		end
		local nextTarget = U.NearestEnemy(player, from, skill.JumpRange, hit)
		if not nextTarget then
			break
		end
		jumps += 1
		damage *= skill.Falloff
		task.wait(0.08)
		if not nextTarget.Parent or not U.Position(nextTarget) then
			break
		end
		U.VFX("Lightning", { From = from, To = U.Position(nextTarget), Color = p.Color, Width = 0.5 })
		target = nextTarget
	end
end

return H
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Ninja</string>
            <string name="Source"><![CDATA[-- สกิลสายนินจา (Ninja)
local Server = script.Parent.Parent
local CombatService = require(Server.CombatService)
local StatusService = require(Server.StatusService)
local U = require(Server.SkillUtil)

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local H = {}

H.ShadowDash = function(player, character, p)
	local skill = p.Skill
	local from, to, distance = U.Dash(character, p.Direction, skill.Range, 0.15)
	U.VFX("Dash", { From = from, To = to, Color = p.Color, Target = character })
	if distance > 0.5 then
		local direction = (to - from).Unit
		for _, model in ipairs(U.EnemiesInLine(player, from, direction, distance + 3, skill.Width, 9)) do
			CombatService.Damage(player, model, skill.Damage, p.Name)
		end
	end
end

-- ดาวกระจาย 5 ดวงเป็นรูปพัด
H.ShurikenFan = function(player, _character, p)
	local skill = p.Skill
	for i = 1, skill.Hits do
		local angle = (i - (skill.Hits + 1) / 2) * skill.SpreadAngle
		local direction = U.Rotate(p.Direction, angle)
		U.Projectile(player, {
			Origin = p.Origin + direction * 2,
			Direction = direction,
			Speed = skill.Speed,
			Range = skill.Range,
			Radius = 0.9,
			Visual = { Color = p.Color, Size = 1.1, Style = "Shuriken" },
			OnHit = function(model)
				CombatService.Damage(player, model, skill.Damage, p.Name)
			end,
		})
	end
end

-- ร่างปลอม 2 ร่างวิ่งไปคนละทาง
H.CloneJutsu = function(player, character, p)
	local skill = p.Skill
	local forward = U.Flat(p.Direction)
	forward = forward.Magnitude > 0.05 and forward.Unit or Vector3.new(0, 0, -1)
	U.VFX("Explosion", { Position = p.Origin, Radius = 6, Color = Color3.fromRGB(220, 220, 220), Duration = 0.35 })

	for _, angle in ipairs({ -55, 55 }) do
		local wasArchivable = character.Archivable
		character.Archivable = true
		local clone = character:Clone()
		character.Archivable = wasArchivable
		if clone then
			for _, item in ipairs(clone:GetDescendants()) do
				if
					item:IsA("BaseScript")
					or item:IsA("ForceField")
					or item:IsA("Highlight")
					or item.Name == "QA_Push"
					or item.Name == "QA_PushAttachment"
				then
					item:Destroy()
				end
			end
			clone.Name = player.Name
			clone:SetAttribute("OwnerId", player.UserId)
			clone:SetAttribute("OneHit", true)
			clone:SetAttribute("Invisible", false)
			local direction = U.Rotate(forward, angle)
			clone:PivotTo(CFrame.lookAt(p.Origin + direction * 3, p.Origin + direction * 10))
			CollectionService:AddTag(clone, U.COMBATANT_TAG)
			clone.Parent = U.EntitiesFolder()

			local humanoid = clone:FindFirstChildOfClass("Humanoid")
			local root = U.Root(clone)
			if humanoid and root then
				root.Anchored = false
				pcall(function()
					root:SetNetworkOwner(nil)
				end)
				humanoid.WalkSpeed = Config.WalkSpeed
				humanoid:MoveTo(p.Origin + direction * 140)
			end
			Debris:AddItem(clone, skill.Duration)
		end
	end
end

-- วาร์ปไปหลังศัตรูแล้วแทง ถ้าเป้าไม่ได้หันมาทางเรา ดาเมจ 2 เท่า
H.Backstab = function(player, character, p)
	local skill = p.Skill
	local origin = p.Origin
	local target = p.Target
	if target and (U.Position(target) - origin).Magnitude > skill.Range + 2 then
		target = nil
	end
	if not target then
		-- ไม่ได้เล็งโดนตัวตรง ๆ: หาศัตรูที่ใกล้สุดในกรวยด้านหน้า
		local forward = U.Flat(p.Direction)
		forward = forward.Magnitude > 0.05 and forward.Unit or Vector3.new(0, 0, -1)
		local bestDist
		for _, model in ipairs(U.AllCombatants()) do
			if U.IsEnemy(player, model) then
				local delta = U.Position(model) - origin
				local dist = delta.Magnitude
				local flat = U.Flat(delta)
				if dist <= skill.Range and flat.Magnitude > 0.1 and flat.Unit:Dot(forward) >= 0.8 then
					if not bestDist or dist < bestDist then
						target, bestDist = model, dist
					end
				end
			end
		end
	end
	if not target then
		p.Refund()
		Remotes.SkillFeedback:FireClient(player, { Type = "Notice", Text = "ไม่มีเป้าหมายในระยะ" })
		return
	end

	local targetRoot = U.Root(target)
	local targetPos = targetRoot.Position
	local targetLook = U.Flat(targetRoot.CFrame.LookVector)
	targetLook = targetLook.Magnitude > 0.05 and targetLook.Unit or Vector3.new(0, 0, -1)
	local toCaster = U.Flat(origin - targetPos)
	toCaster = toCaster.Magnitude > 0.05 and toCaster.Unit or -targetLook
	local facingUs = targetLook:Dot(toCaster) > 0.3

	local destination = targetPos - targetLook * 3.5
	if not U.HasLineOfSight(targetPos, destination) then
		destination = targetPos + toCaster * 3
	end
	U.VFX("Dash", { From = origin, To = destination, Color = p.Color, Target = character })
	U.Teleport(character, destination, targetPos - destination)

	local damage = facingUs and skill.Damage or skill.Damage * 2
	local direction = U.Flat(targetPos - destination)
	direction = direction.Magnitude > 0.05 and direction.Unit or targetLook
	U.VFX("Slash", { Position = destination, Direction = direction, Range = 6, Width = 5, Color = p.Color, Final = not facingUs })
	CombatService.Damage(player, target, damage, p.Name)
end

-- ควันพราง: เราล่องหนเมื่ออยู่ในควัน (client ซ่อนชื่อ/แถบเลือดให้คนที่อยู่ในควัน)
H.SmokeBomb = function(_player, character, p)
	local skill = p.Skill
	local center = p.Origin
	U.VFX("Zone", { Position = center, Radius = skill.Radius, Color = Color3.fromRGB(150, 160, 150), Duration = skill.Duration, Kind = "Smoke" })
	local step = 0.25
	for _ = 1, math.floor(skill.Duration / step + 0.5) do
		if not CombatService.IsAlive(character) then
			return
		end
		local position = U.Position(character)
		if position and (position - center).Magnitude <= skill.Radius then
			StatusService.SetInvisible(character, step + 0.2)
		end
		task.wait(step)
	end
end

return H
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">QuantumSword</string>
            <string name="Source"><![CDATA[-- สกิลสายดาบควอนตัม (Quantum Sword)
local Server = script.Parent.Parent
local CombatService = require(Server.CombatService)
local U = require(Server.SkillUtil)

local H = {}

-- ร่างควอนตัม 2 ร่าง ฟันพร้อมกันจาก 3 ทิศ
H.SuperpositionSlash = function(player, character, p)
	local skill = p.Skill
	local forward = U.Flat(p.Direction)
	forward = forward.Magnitude > 0.05 and forward.Unit or Vector3.new(0, 0, -1)
	local center = p.Origin + forward * 5
	for _, angle in ipairs({ 120, 240 }) do
		local offset = U.Rotate(-forward, angle) * 7
		U.VFX("Ghost", { CFrame = CFrame.lookAt(center + offset, center), Color = p.Color, Duration = 0.6 })
	end
	for i = 1, skill.Hits do
		if not CombatService.IsAlive(character) then
			return
		end
		local direction = U.Rotate(forward, (i - 1) * 120)
		U.VFX("Slash", {
			Position = center - direction * 6,
			Direction = direction,
			Range = skill.Range,
			Width = 12,
			Color = p.Color,
			Final = i == skill.Hits,
		})
		for _, model in ipairs(U.EnemiesInRadius(player, center, skill.Range - 1)) do
			CombatService.Damage(player, model, skill.Damage, p.Name)
		end
		task.wait(0.12)
	end
end

-- ฟันทะลุกำแพงเป็นเส้นตรง
H.PhaseCut = function(player, _character, p)
	local skill = p.Skill
	local direction = p.Direction
	local to = p.Origin + direction * skill.Range
	U.VFX("Slash", { Position = p.Origin, Direction = direction, Range = 10, Width = 10, Color = p.Color, Final = true })
	U.VFX("Beam", { From = p.Origin, To = to, Color = p.Color, Width = skill.Width * 0.6, Duration = 0.3 })
	for _, model in ipairs(U.EnemiesInLine(player, p.Origin, direction, skill.Range, skill.Width, 9)) do
		CombatService.Damage(player, model, skill.Damage, p.Name)
	end
end

-- ปาดาบ ถ้าโดนศัตรูจะวาร์ปไปหา
H.EntangleThrow = function(player, character, p)
	local skill = p.Skill
	U.Projectile(player, {
		Origin = p.Origin + p.Direction * 2,
		Direction = p.Direction,
		Speed = skill.Speed,
		Range = skill.Range,
		Radius = 1.2,
		Visual = { Color = p.Color, Size = 1, Style = "Blade" },
		OnHit = function(model)
			CombatService.Damage(player, model, skill.Damage, p.Name)
			local targetPos = U.Position(model)
			if targetPos and CombatService.IsAlive(character) then
				local back = U.Flat(p.Direction)
				back = back.Magnitude > 0.05 and back.Unit or Vector3.new(0, 0, -1)
				local destination = targetPos - back * 4
				if not U.HasLineOfSight(targetPos, destination) then
					destination = targetPos + Vector3.new(0, 4, 0)
				end
				local from = character:GetPivot().Position
				U.Teleport(character, destination, back)
				U.VFX("Beam", { From = from, To = destination, Color = p.Color, Width = 0.5, Duration = 0.25 })
				U.VFX("Explosion", { Position = destination, Radius = 4, Color = p.Color, Duration = 0.3 })
			end
			return true
		end,
	})
end

-- หมุนตัวพร้อมดาบลอยรอบตัว
H.BladeStorm = function(player, character, p)
	local skill = p.Skill
	U.VFX("Aura", { Target = character, Color = p.Color, Duration = skill.Duration, Kind = "BladeStorm", Radius = skill.Radius })
	for _ = 1, math.floor(skill.Duration / skill.Tick) do
		if not CombatService.IsAlive(character) then
			return
		end
		local position = U.Position(character)
		for _, model in ipairs(U.EnemiesInRadius(player, position, skill.Radius)) do
			CombatService.Damage(player, model, skill.Damage, p.Name)
		end
		task.wait(skill.Tick)
	end
end

-- คลื่นพลังรูปพระจันทร์เสี้ยว
H.QuantumWave = function(player, _character, p)
	local skill = p.Skill
	U.VFX("Slash", { Position = p.Origin, Direction = p.Direction, Range = 8, Width = 10, Color = p.Color })
	U.Projectile(player, {
		Origin = p.Origin + p.Direction * 3,
		Direction = p.Direction,
		Speed = skill.Speed,
		Range = skill.Range,
		Radius = skill.Radius,
		Pierce = true,
		Visual = { Color = p.Color, Size = skill.Radius * 2, Style = "Crescent" },
		OnHit = function(model)
			CombatService.Damage(player, model, skill.Damage, p.Name)
		end,
	})
end

return H
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">ShadowScythe</string>
            <string name="Source"><![CDATA[-- สกิลสายเคียวเงา (Shadow Scythe)
local Server = script.Parent.Parent
local CombatService = require(Server.CombatService)
local StatusService = require(Server.StatusService)
local U = require(Server.SkillUtil)

local H = {}

local GLOW = Color3.fromHex("#9B4DFF") -- สีเรืองแสงของเงา (สีประจำสายเข้มเกินไปสำหรับเอฟเฟกต์)

-- ปาโซ่เงา ดึงศัตรูมาหา + Stun
H.ReapHook = function(player, character, p)
	local skill = p.Skill
	U.Projectile(player, {
		Origin = p.Origin + p.Direction * 2,
		Direction = p.Direction,
		Speed = skill.Speed,
		Range = skill.Range,
		Radius = 1.4,
		Visual = { Color = GLOW, Size = 1.2, Style = "Hook" },
		OnHit = function(model)
			CombatService.Damage(player, model, skill.Damage, p.Name)
			local targetPos = U.Position(model)
			local casterPos = U.Position(character)
			if targetPos and casterPos and model.Parent then
				U.VFX("Beam", { From = casterPos, To = targetPos, Color = GLOW, Width = 0.4, Duration = 0.3 })
				local delta = U.Flat(casterPos - targetPos)
				local distance = math.max(0, delta.Magnitude - 4)
				if distance > 1 then
					StatusService.Knockback(model, delta.Unit * (distance / 0.25), 0.25)
				end
				StatusService.Stun(model, skill.Stun)
			end
			return true
		end,
	})
end

-- หมุนเคียว 360°
H.DeathSpin = function(player, character, p)
	local skill = p.Skill
	U.VFX("Spin", { Target = character, Radius = skill.Radius, Color = GLOW, Duration = 0.35 })
	for _, model in ipairs(U.EnemiesInRadius(player, p.Origin, skill.Radius)) do
		CombatService.Damage(player, model, skill.Damage, p.Name)
	end
end

-- ฟันหนัก ดูดเลือดคืน 100% ของดาเมจ
H.SoulDrain = function(player, character, p)
	local skill = p.Skill
	local direction = p.Direction
	U.VFX("Slash", { Position = p.Origin, Direction = direction, Range = skill.Range, Width = skill.Width, Color = GLOW, Final = true })
	local total = 0
	for _, model in ipairs(U.EnemiesInLine(player, p.Origin - direction, direction, skill.Range + 1, skill.Width, 9)) do
		local position = U.Position(model)
		local dealt = CombatService.Damage(player, model, skill.Damage, p.Name)
		if dealt > 0 and position then
			total += dealt
			U.VFX("Beam", { From = position, To = p.Origin, Color = Color3.fromRGB(120, 255, 140), Width = 0.4, Duration = 0.35 })
		end
	end
	if total > 0 then
		CombatService.Heal(character, total)
	end
end

-- คลื่นจันทร์เสี้ยวสีดำ + Slow
H.CrescentReap = function(player, _character, p)
	local skill = p.Skill
	U.VFX("Slash", { Position = p.Origin, Direction = p.Direction, Range = 9, Width = 12, Color = GLOW })
	U.Projectile(player, {
		Origin = p.Origin + p.Direction * 3,
		Direction = p.Direction,
		Speed = skill.Speed,
		Range = skill.Range,
		Radius = skill.Radius,
		Pierce = true,
		Visual = { Color = GLOW, Size = skill.Radius * 2, Style = "Crescent", Dark = true },
		OnHit = function(model)
			if CombatService.Damage(player, model, skill.Damage, p.Name) > 0 then
				StatusService.Slow(model, skill.SlowPercent, skill.SlowDuration)
			end
		end,
	})
end

-- ล่องหน + การโจมตีครั้งแรกแรงขึ้น
H.ShadowVeil = function(_player, character, p)
	local skill = p.Skill
	U.VFX("Explosion", { Position = p.Origin, Radius = 5, Color = GLOW, Duration = 0.35 })
	StatusService.SetInvisible(character, skill.Duration)
	StatusService.Apply(character, "Empower", skill.BonusWindow, { Bonus = skill.Bonus })
end

return H
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Time</string>
            <string name="Source"><![CDATA[-- สกิลสายเวลา (Time)
local Server = script.Parent.Parent
local CombatService = require(Server.CombatService)
local StatusService = require(Server.StatusService)
local U = require(Server.SkillUtil)

local Players = game:GetService("Players")

local SpawnService = require(Server.SpawnService)

local H = {}

-- ประวัติตำแหน่ง/เลือดของผู้เล่นสายเวลา เก็บทุก 0.1 วิ (ใช้กับ "ย้อนเวลา")
local HISTORY_STEP = 0.1
local HISTORY_KEEP = 4
local history = {} -- [character] = { { T, CFrame, Health } }

SpawnService.OnEnterArena(function(_player, character)
	history[character] = nil
end)

task.spawn(function()
	while true do
		task.wait(HISTORY_STEP)
		local now = os.clock()
		for _, player in ipairs(Players:GetPlayers()) do
			local character = player.Character
			if
				character
				and player:GetAttribute("Subclass") == "Time"
				and player:GetAttribute("InArena")
				and CombatService.IsAlive(character)
				and not CombatService.InLobby(character)
			then
				local list = history[character]
				if not list then
					list = {}
					history[character] = list
				end
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				table.insert(list, { T = now, CFrame = character:GetPivot(), Health = humanoid.Health })
				while list[1] and now - list[1].T > HISTORY_KEEP do
					table.remove(list, 1)
				end
			end
		end
		for character in pairs(history) do
			if not character.Parent then
				history[character] = nil
			end
		end
	end
end)

H.TimeStop = function(player, _character, p)
	local skill = p.Skill
	U.VFX("Explosion", { Position = p.Origin, Radius = skill.Radius, Color = p.Color, Duration = 0.5 })
	for _, model in ipairs(U.EnemiesInRadius(player, p.Origin, skill.Radius)) do
		StatusService.Freeze(model, skill.Duration)
	end
end

H.Rewind = function(_player, character, p)
	local list = history[character]
	if not list or #list == 0 then
		p.Refund()
		return
	end
	local target = os.clock() - p.Skill.Seconds
	local entry = list[1]
	for _, item in ipairs(list) do
		if item.T <= target then
			entry = item
		else
			break
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local from = p.Origin
	U.VFX("Ghost", { CFrame = character:GetPivot(), Color = p.Color, Duration = 0.6 })
	StatusService.StopPush(character)
	character:PivotTo(entry.CFrame)
	humanoid.Health = math.clamp(entry.Health, 1, humanoid.MaxHealth)
	history[character] = nil
	U.VFX("Beam", { From = from, To = entry.CFrame.Position, Color = p.Color, Width = 0.5, Duration = 0.4 })
	U.VFX("Explosion", { Position = entry.CFrame.Position, Radius = 5, Color = p.Color, Duration = 0.4 })
end

H.Haste = function(_player, character, p)
	StatusService.Haste(character, p.Skill.SpeedBonus, p.Skill.Duration)
end

H.SlowField = function(player, _character, p)
	local skill = p.Skill
	local center = p.Point + Vector3.new(0, 2, 0)
	U.VFX("Zone", { Position = center, Radius = skill.Radius, Color = p.Color, Duration = skill.Duration, Kind = "SlowField" })
	local step = 0.25
	for _ = 1, math.floor(skill.Duration / step + 0.5) do
		for _, model in ipairs(U.EnemiesInRadius(player, center, skill.Radius)) do
			StatusService.Slow(model, skill.SlowPercent, step + 0.2)
		end
		task.wait(step)
	end
end

H.TimeBomb = function(player, _character, p)
	local skill = p.Skill
	U.Projectile(player, {
		Origin = p.Origin + p.Direction * 2,
		Direction = p.Direction,
		Speed = skill.Speed,
		Range = skill.Range,
		Radius = 1.2,
		Visual = { Color = p.Color, Size = 1.6, Style = "Orb" },
		OnHit = function(model)
			U.VFX("Aura", { Target = model, Color = p.Color, Duration = skill.Delay, Kind = "Bomb" })
			task.delay(skill.Delay, function()
				local position = model.Parent and U.Position(model)
				if not position then
					return
				end
				U.VFX("Explosion", { Position = position, Radius = skill.Radius, Color = p.Color, Duration = 0.45 })
				for _, enemy in ipairs(U.EnemiesInRadius(player, position, skill.Radius)) do
					CombatService.Damage(player, enemy, skill.Damage, p.Name)
				end
			end)
			return true
		end,
	})
end

return H
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">SkillService</string>
          <string name="Source"><![CDATA[-- รับคำสั่งใช้สกิลจาก client → ตรวจสอบทุกอย่าง → คิดคูลดาวน์ → เรียก handler
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Classes = require(Shared:WaitForChild("Classes"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local CombatService = require(script.Parent.CombatService)
local LoadoutService = require(script.Parent.LoadoutService)
local SpawnService = require(script.Parent.SpawnService)
local StatusService = require(script.Parent.StatusService)
local U = require(script.Parent.SkillUtil)

local HandlerFolder = script.Parent.SkillHandlers
local Basic = require(HandlerFolder.Basic)

local SkillService = {}

local Handlers = {} -- [subclassId] = { [skillId] = function(player, character, payload) }
local states = {} -- [player] = { Cooldowns, Totals, Rate, Window, Count }

local SLOT_KEYS = { "0", "1", "2", "3", "dash" }

local function newState()
	local state = { Cooldowns = {}, Totals = {}, Rate = 1, Window = 0, Count = 0 }
	for _, key in ipairs(SLOT_KEYS) do
		state.Cooldowns[key] = 0
		state.Totals[key] = 1
	end
	return state
end

local function sync(player)
	local state = states[player]
	if state then
		Remotes.SkillFeedback:FireClient(player, {
			Type = "Cooldowns",
			Remaining = state.Cooldowns,
			Totals = state.Totals,
			Rate = state.Rate,
		})
	end
end

local function setCooldown(player, key, seconds)
	local state = states[player]
	if state then
		state.Cooldowns[key] = seconds
		state.Totals[key] = math.max(seconds, 0.05)
		sync(player)
	end
end

function SkillService.Reset(player)
	states[player] = newState()
	sync(player)
end

local function deny(player, key, reason)
	Remotes.SkillFeedback:FireClient(player, { Type = "Denied", Slot = key, Reason = reason })
end

-- จำกัดการยิง Remote ไม่เกิน Config.RemoteRateLimit ครั้ง/วิ
local function rateOk(state)
	local now = os.clock()
	if now - state.Window >= 1 then
		state.Window = now
		state.Count = 0
	end
	state.Count += 1
	return state.Count <= Config.RemoteRateLimit
end

local function isFiniteVector(value)
	return typeof(value) == "Vector3"
		and value.X == value.X
		and value.Y == value.Y
		and value.Z == value.Z
		and value.Magnitude < 1e5
end

local function runHandler(handler, player, character, payload)
	task.spawn(function()
		local ok, err = pcall(handler, player, character, payload)
		if not ok then
			warn(string.format("[SkillService] สกิล %s ทำงานผิดพลาด: %s", tostring(payload.Name), tostring(err)))
		end
	end)
end

local function useDash(player, character)
	-- ทิศพุ่ง = ทิศที่กำลังเดิน (ดูจากความเร็วจริงของร่าง) ถ้ายืนนิ่งให้พุ่งไปทางที่หันหน้า
	local root = U.Root(character)
	local direction = U.Flat(root.AssemblyLinearVelocity)
	if direction.Magnitude < 3 then
		direction = root.CFrame.LookVector
	end
	setCooldown(player, "dash", Config.Dash.Cooldown)
	StatusService.Apply(character, "DashIFrame", Config.Dash.IFrame)
	local from, to = U.Dash(character, direction, Config.Dash.Distance, Config.Dash.Duration)
	local sub = Classes.GetSubclass(player:GetAttribute("Subclass"))
	U.VFX("Dash", { From = from, To = to, Color = sub and sub.Color or Color3.new(1, 1, 1), Target = character })
end

local function onUseSkill(player, slot, aimPosition)
	local state = states[player]
	if not state or not rateOk(state) then
		return
	end

	-- ตรวจรูปแบบข้อมูลที่ client ส่งมา
	local key
	if slot == "dash" then
		key = "dash"
	elseif slot == 0 or slot == 1 or slot == 2 or slot == 3 then
		key = tostring(slot)
	else
		return
	end
	if not isFiniteVector(aimPosition) then
		return
	end

	-- ผู้เล่นต้องมีชีวิตและอยู่ในสนาม
	local character = player.Character
	if not character or not CombatService.IsAlive(character) then
		return
	end
	if not player:GetAttribute("InArena") or CombatService.InLobby(character) then
		return
	end

	if not StatusService.CanAct(character) then
		return deny(player, key, "ติดสถานะ ใช้สกิลไม่ได้")
	end
	if state.Cooldowns[key] > 0 then
		sync(player)
		return
	end

	if key == "dash" then
		useDash(player, character)
		return
	end

	if StatusService.Has(character, "Phase") then
		return deny(player, key, "อยู่ในมิติ โจมตีไม่ได้")
	end
	if StatusService.Has(character, "Channel") then
		return
	end

	local loadout = LoadoutService.Get(player)
	local sub = loadout and Classes.GetSubclass(loadout.Subclass)
	if not sub then
		return
	end

	local skill, handler, cooldown
	if key == "0" then
		skill = sub.Basic
		if not Basic.CanUse(player, character, skill) then
			return
		end
		handler = Basic.Use
		cooldown = Basic.GetCooldown(player, character, skill)
	else
		-- สกิลต้องอยู่ในชุดที่ผู้เล่นเลือกไว้จริง
		local skillId = loadout.Skills[slot]
		skill = skillId and sub.SkillById[skillId]
		handler = skill and Handlers[sub.Id] and Handlers[sub.Id][skill.Id]
		if not skill or not handler then
			return
		end
		cooldown = skill.Cooldown
	end

	local origin, direction, point, target = U.ResolveAim(player, character, aimPosition, skill.Range)

	-- โจมตีแล้วอมตะตอนเกิดหายทันที และหลุดล่องหน
	StatusService.Remove(character, "SpawnProtect")
	if skill.Damage then
		StatusService.Remove(character, "Invisible")
	end

	setCooldown(player, key, cooldown)

	local payload = {
		Slot = key,
		Skill = skill,
		Subclass = sub,
		Name = skill.Name,
		Color = sub.Color,
		Origin = origin,
		Direction = direction,
		Point = point,
		Target = target,
		Refund = function()
			setCooldown(player, key, 0.5)
		end,
	}
	runHandler(handler, player, character, payload)
end

function SkillService.Init()
	-- โหลด handler ของทุกสายย่อย แล้วตรวจว่ามีครบทุกสกิล
	for _, subId in ipairs(Classes.SubclassOrder) do
		local module = HandlerFolder:FindFirstChild(subId)
		if module then
			Handlers[subId] = require(module)
		else
			Handlers[subId] = {}
			warn("[SkillService] ไม่พบ handler ของสาย " .. subId)
		end
		for _, skill in ipairs(Classes.Subclasses[subId].Skills) do
			if type(Handlers[subId][skill.Id]) ~= "function" then
				warn(string.format("[SkillService] สกิล %s.%s ยังไม่มี handler", subId, skill.Id))
			end
		end
	end

	Players.PlayerAdded:Connect(function(player)
		states[player] = newState()
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		states[player] = newState()
	end
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
		Basic.Cleanup(player)
	end)

	SpawnService.OnEnterArena(function(player)
		SkillService.Reset(player)
		local loadout = LoadoutService.Get(player)
		local sub = loadout and Classes.GetSubclass(loadout.Subclass)
		Basic.Reset(player, sub and sub.Basic)
	end)

	Remotes.UseSkill.OnServerEvent:Connect(onUseSkill)

	-- นับคูลดาวน์ฝั่ง server (เร่งเวลา = ลดเร็วขึ้น 2 เท่า)
	RunService.Heartbeat:Connect(function(dt)
		for player, state in pairs(states) do
			local character = player.Character
			local rate = (character and StatusService.Has(character, "Haste")) and 2 or 1
			for _, key in ipairs(SLOT_KEYS) do
				if state.Cooldowns[key] > 0 then
					state.Cooldowns[key] = math.max(0, state.Cooldowns[key] - dt * rate)
				end
			end
			if rate ~= state.Rate then
				state.Rate = rate
				sync(player)
			end
		end
	end)
end

return SkillService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">SkillUtil</string>
          <string name="Source"><![CDATA[-- ตัวช่วยที่ SkillHandlers ใช้ร่วมกัน: หาเป้า, hitbox, กระสุน, การเคลื่อนที่, สั่งเอฟเฟกต์
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))

local CombatService = require(script.Parent.CombatService)
local StatusService = require(script.Parent.StatusService)

local U = {}

U.COMBATANT_TAG = "QA_Combatant"

local START_BACK = 1.5

local function ensureFolder(name)
	local folder = Workspace:FindFirstChild(name)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = Workspace
	end
	return folder
end

function U.MapFolder()
	return ensureFolder("Map")
end

function U.EffectsFolder()
	return ensureFolder("Effects")
end

function U.EntitiesFolder()
	return ensureFolder("Entities")
end

function U.VFX(effectId, data)
	Remotes.PlayVFX:FireAllClients(effectId, data)
end

function U.Root(model)
	return model and model:FindFirstChild("HumanoidRootPart")
end

function U.Position(model)
	local root = U.Root(model)
	return root and root.Position
end

function U.Flat(vector)
	return Vector3.new(vector.X, 0, vector.Z)
end

function U.Rotate(direction, degrees)
	return (CFrame.Angles(0, math.rad(degrees), 0) * direction)
end

-- หา Model ที่มี Humanoid จากชิ้นส่วน
function U.ModelFromPart(part)
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		if model:FindFirstChildOfClass("Humanoid") then
			return model
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

-- เป้าที่โจมตีได้: ยังมีชีวิต, ไม่ใช่ตัวเอง/ของตัวเอง, ไม่อยู่ใน Lobby, ไม่อมตะ
function U.IsEnemy(player, model)
	if not CombatService.IsAlive(model) then
		return false
	end
	if player then
		if model == player.Character or model:GetAttribute("OwnerId") == player.UserId then
			return false
		end
	end
	if CombatService.InLobby(model) or StatusService.IsInvulnerable(model) then
		return false
	end
	return true
end

function U.AllCombatants()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			table.insert(list, player.Character)
		end
	end
	for _, model in ipairs(CollectionService:GetTagged(U.COMBATANT_TAG)) do
		table.insert(list, model)
	end
	return list
end

local function overlapParams(player)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = { U.MapFolder(), U.EffectsFolder() }
	if player and player.Character then
		table.insert(exclude, player.Character)
	end
	params.FilterDescendantsInstances = exclude
	return params
end

local function enemiesFromParts(player, parts)
	local seen, list = {}, {}
	for _, part in ipairs(parts) do
		local model = U.ModelFromPart(part)
		if model and not seen[model] then
			seen[model] = true
			if U.IsEnemy(player, model) then
				table.insert(list, model)
			end
		end
	end
	return list
end

function U.EnemiesInRadius(player, position, radius)
	local parts = Workspace:GetPartBoundsInRadius(position, radius, overlapParams(player))
	return enemiesFromParts(player, parts)
end

function U.EnemiesInBox(player, cframe, size)
	local parts = Workspace:GetPartBoundsInBox(cframe, size, overlapParams(player))
	return enemiesFromParts(player, parts)
end

-- กล่องเส้นตรงจาก origin ไปตาม direction (ใช้กับฟัน/พุ่ง/เลเซอร์ทะลุ)
function U.EnemiesInLine(player, origin, direction, length, width, height)
	local center = origin + direction * (length / 2)
	local cframe = CFrame.lookAt(center, center + direction)
	return U.EnemiesInBox(player, cframe, Vector3.new(width, height or 8, length))
end

function U.NearestEnemy(player, position, radius, exclude)
	local best, bestDist
	for _, model in ipairs(U.AllCombatants()) do
		if not (exclude and exclude[model]) and U.IsEnemy(player, model) then
			local dist = (U.Position(model) - position).Magnitude
			if dist <= radius and (not bestDist or dist < bestDist) then
				best, bestDist = model, dist
			end
		end
	end
	return best, bestDist
end

local function worldParams()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { U.MapFolder() }
	params.RespectCanCollide = true
	return params
end

-- Raycast เฉพาะแผนที่ (กำแพง/พื้น)
function U.RaycastWorld(origin, displacement)
	return Workspace:Raycast(origin, displacement, worldParams())
end

function U.HasLineOfSight(from, to)
	return U.RaycastWorld(from, to - from) == nil
end

-- หาพื้นใต้จุดที่กำหนด
function U.GroundBelow(position, maxDrop)
	local result = U.RaycastWorld(position + Vector3.new(0, 4, 0), Vector3.new(0, -(maxDrop or 300), 0))
	return result and result.Position or nil
end

-- ยิงทันที (hitscan): คืนค่า (เป้า หรือ nil, จุดที่โดน)
function U.Hitscan(player, origin, direction, range, radius)
	local filter = { U.EffectsFolder() }
	if player.Character then
		table.insert(filter, player.Character)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = filter
	-- เริ่มยิงจากด้านหลังเล็กน้อย เป้าที่ยืนชิดตัวจะได้ไม่หลุด (Spherecast ไม่นับสิ่งที่ซ้อนอยู่ตั้งแต่ต้น)
	local start = origin - direction * START_BACK
	for _ = 1, 12 do
		local result = Workspace:Spherecast(start, radius or 1, direction * (range + START_BACK), params)
		if not result then
			break
		end
		local model = U.ModelFromPart(result.Instance)
		if model then
			if U.IsEnemy(player, model) then
				return model, result.Position
			end
			table.insert(filter, model)
		elseif result.Instance.CanCollide then
			return nil, result.Position
		else
			table.insert(filter, result.Instance)
		end
		params.FilterDescendantsInstances = filter
	end
	return nil, origin + direction * range
end

--[[ กระสุนที่ server จำลองเอง (client แค่วาดภาพตาม)
	opts = {
		Origin, Direction, Speed, Range, Radius,
		Pierce = จำนวนเป้าที่ทะลุได้เพิ่ม (true = ทะลุทุกคน),
		OnHit = function(model, position) -> true ถ้าต้องการหยุดกระสุน,
		OnEnd = function(position, hitWorld),
		Visual = ตารางข้อมูลเอฟเฟกต์ (Color, Size, Style) หรือ nil,
	}
]]
function U.Projectile(player, opts)
	local origin, direction = opts.Origin, opts.Direction
	local speed, range, radius = opts.Speed, opts.Range, opts.Radius or 1
	local pierce = opts.Pierce or 0

	if opts.Visual then
		local visual = table.clone(opts.Visual)
		visual.Origin = origin
		visual.Direction = direction
		visual.Speed = speed
		visual.Range = range
		visual.Owner = player.Character
		visual.Pierce = pierce == true or pierce > 0
		U.VFX("Projectile", visual)
	end

	local filter = { U.EffectsFolder() }
	if player.Character then
		table.insert(filter, player.Character)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = filter

	local function finish(position, hitWorld)
		if opts.OnEnd then
			opts.OnEnd(position, hitWorld)
		end
	end

	-- จัดการเมื่อกระสุนโดนเป้า คืนค่า true ถ้ากระสุนต้องหยุด
	local function hitEnemy(model, position)
		local stop = opts.OnHit and opts.OnHit(model, position)
		if pierce ~= true then
			pierce -= 1
		end
		return stop or (pierce ~= true and pierce < 0)
	end

	task.spawn(function()
		-- เป้าที่ซ้อนอยู่กับกระสุนตั้งแต่ต้น (ยืนชิดตัว) Spherecast จะมองไม่เห็น จึงเช็กด้วยรัศมีก่อน
		for _, model in ipairs(U.EnemiesInRadius(player, origin, radius + 0.5)) do
			table.insert(filter, model)
			if hitEnemy(model, U.Position(model)) then
				finish(origin, false)
				return
			end
		end
		params.FilterDescendantsInstances = filter

		local position = origin - direction * START_BACK
		local traveled = -START_BACK
		while traveled < range do
			local dt = RunService.Heartbeat:Wait()
			local step = math.min(speed * dt, range - traveled)
			for _ = 1, 10 do
				local result = Workspace:Spherecast(position, radius, direction * step, params)
				if not result then
					break
				end
				local model = U.ModelFromPart(result.Instance)
				if model then
					table.insert(filter, model)
					params.FilterDescendantsInstances = filter
					if U.IsEnemy(player, model) and hitEnemy(model, result.Position) then
						finish(result.Position, false)
						return
					end
				elseif result.Instance.CanCollide then
					finish(result.Position, true)
					return
				else
					table.insert(filter, result.Instance)
					params.FilterDescendantsInstances = filter
				end
			end
			position += direction * step
			traveled += step
		end
		finish(position, false)
	end)
end

-- ระยะที่เคลื่อนที่ได้จริงโดยไม่ทะลุกำแพง
function U.ClampMove(origin, direction, distance)
	local result = U.RaycastWorld(origin, direction * (distance + 2))
	if result then
		return math.max(0, (result.Position - origin).Magnitude - 3)
	end
	return distance
end

-- พุ่งด้วยแรงผลัก คืนค่า (จุดเริ่ม, จุดจบโดยประมาณ, ระยะ)
function U.Dash(character, direction, distance, duration)
	local root = U.Root(character)
	local origin = root.Position
	local flat = U.Flat(direction)
	if flat.Magnitude < 0.05 then
		flat = U.Flat(root.CFrame.LookVector)
	end
	flat = flat.Unit
	local allowed = U.ClampMove(origin, flat, distance)
	if allowed > 1 then
		StatusService.Push(character, flat * (allowed / duration), duration)
	end
	return origin, origin + flat * allowed, allowed
end

function U.Teleport(character, position, lookDirection)
	local look = lookDirection and U.Flat(lookDirection) or nil
	if not look or look.Magnitude < 0.05 then
		look = U.Flat(character:GetPivot().LookVector)
	end
	StatusService.StopPush(character)
	character:PivotTo(CFrame.lookAt(position, position + look.Unit))
end

-- คำนวณจุดเล็งที่ถูกต้องจาก aimPosition ที่ client ส่งมา (ตัดระยะไม่ให้เกิน range)
-- คืนค่า origin, direction (หน่วยเดียว), point (จุดบนพื้น), target (ศัตรูที่เล็งอยู่ หรือ nil)
function U.ResolveAim(player, character, aimPosition, range)
	local root = U.Root(character)
	local origin = root.Position
	local delta = aimPosition - origin
	local flat = U.Flat(delta)
	local flatDir
	if flat.Magnitude < 0.5 then
		flatDir = U.Flat(root.CFrame.LookVector).Unit
	else
		flatDir = flat.Unit
	end

	-- ถ้าเล็งโดนตัวศัตรู ให้ยิงเป็น 3 มิติไปหาเป้า ไม่งั้นยิงแนวราบ
	local direction = flatDir
	local target = U.NearestEnemy(player, aimPosition, 6)
	if target then
		local toTarget = U.Position(target) - origin
		if toTarget.Magnitude > 1 then
			direction = toTarget.Unit
		end
	end

	local maxRange = math.max(range or 0, 0)
	local distance = math.min(flat.Magnitude, maxRange)
	local point = origin + flatDir * distance
	local probeY = math.clamp(aimPosition.Y, origin.Y - 80, origin.Y + 80)
	local ground = U.GroundBelow(Vector3.new(point.X, probeY + 2, point.Z))
		or U.GroundBelow(Vector3.new(point.X, origin.Y + 40, point.Z))
	if ground then
		point = ground
	else
		point = Vector3.new(point.X, origin.Y - 3, point.Z)
	end

	return origin, direction, point, target
end

return U
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">SpawnService</string>
          <string name="Source"><![CDATA[-- เกิดใหม่, ป้องกันตอนเกิด, วาร์ป Lobby ↔ Arena, แถบเลือดเหนือหัว, อาวุธในมือ
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Classes = require(Shared:WaitForChild("Classes"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local CombatService = require(script.Parent.CombatService)
local StatusService = require(script.Parent.StatusService)

local SpawnService = {}

local arenaSpawns = {} -- { Vector3 }
local enterCallbacks = {}

-- ลงทะเบียนฟังก์ชันที่จะถูกเรียกเมื่อผู้เล่นเข้าสนาม (ทั้งกดลงสนามและเกิดใหม่)
function SpawnService.OnEnterArena(callback)
	table.insert(enterCallbacks, callback)
end

local function subclassOf(player)
	return Classes.GetSubclass(player:GetAttribute("Subclass"))
end

---------------------------------------------------------------------------
-- แถบเลือดเหนือหัว
---------------------------------------------------------------------------
local function buildOverhead(player, character, humanoid)
	local head = character:WaitForChild("Head", 5)
	if not head then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "QA_Overhead"
	gui.Adornee = head
	gui.Size = UDim2.fromScale(5.5, 1.3)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.PlayerToHideFrom = player

	local name = Instance.new("TextLabel")
	name.Name = "PlayerName"
	name.BackgroundTransparency = 1
	name.Size = UDim2.fromScale(1, 0.58)
	name.Font = Enum.Font.GothamBold
	name.TextScaled = true
	name.TextStrokeTransparency = 0.4
	name.Text = player.DisplayName
	name.Parent = gui

	local back = Instance.new("Frame")
	back.Name = "Bar"
	back.AnchorPoint = Vector2.new(0.5, 1)
	back.Position = UDim2.fromScale(0.5, 0.95)
	back.Size = UDim2.fromScale(0.9, 0.26)
	back.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
	back.BorderSizePixel = 0
	back.Parent = gui

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BorderSizePixel = 0
	fill.Parent = back

	local function recolor()
		local sub = subclassOf(player)
		local color = sub and sub.Color or Color3.new(1, 1, 1)
		-- สีเข้มมาก (เช่นเคียวเงา) ให้สว่างขึ้นเพื่อให้อ่านออก
		local h, s, v = color:ToHSV()
		local bright = Color3.fromHSV(h, s * 0.8, math.max(v, 0.75))
		name.TextColor3 = bright
		fill.BackgroundColor3 = bright
	end
	recolor()
	local attrConn = player:GetAttributeChangedSignal("Subclass"):Connect(recolor)

	humanoid.HealthChanged:Connect(function(health)
		fill.Size = UDim2.fromScale(math.clamp(health / humanoid.MaxHealth, 0, 1), 1)
	end)
	gui.Destroying:Connect(function()
		attrConn:Disconnect()
	end)
	gui.Parent = head
end

---------------------------------------------------------------------------
-- อาวุธในมือ (สร้างจาก Part ล้วน)
---------------------------------------------------------------------------
local function weaponPart(size, color, material, shape)
	local part = Instance.new("Part")
	part.Size = size
	part.Color = color
	part.Material = material or Enum.Material.Neon
	part.Shape = shape or Enum.PartType.Block
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	return part
end

function SpawnService.AttachWeapon(player, character)
	local old = character:FindFirstChild("QA_Weapon")
	if old then
		old:Destroy()
	end
	local sub = subclassOf(player)
	if not sub then
		return
	end
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if not hand then
		return
	end
	local gripY = hand.Name == "Right Arm" and -1 or -0.15

	local model = Instance.new("Model")
	model.Name = "QA_Weapon"

	local pieces = {} -- { part, offset }
	local dark = Color3.fromRGB(30, 30, 40)
	if sub.Id == "QuantumSword" then
		table.insert(pieces, { weaponPart(Vector3.new(0.25, 0.5, 4.2), sub.Color), CFrame.new(0, gripY, -2.4) })
		table.insert(pieces, { weaponPart(Vector3.new(1.2, 0.3, 0.3), dark, Enum.Material.Metal), CFrame.new(0, gripY, -0.3) })
	elseif sub.Id == "EnergyGun" then
		table.insert(pieces, { weaponPart(Vector3.new(0.5, 0.7, 1.8), dark, Enum.Material.Metal), CFrame.new(0, gripY, -0.9) })
		table.insert(pieces, { weaponPart(Vector3.new(0.3, 0.3, 0.6), sub.Color), CFrame.new(0, gripY + 0.1, -2) })
	elseif sub.Id == "ShadowScythe" then
		table.insert(pieces, { weaponPart(Vector3.new(0.25, 0.25, 6), dark, Enum.Material.Metal), CFrame.new(0, gripY, -1.5) })
		table.insert(pieces, {
			weaponPart(Vector3.new(0.15, 2.8, 0.7), Color3.fromHex("#9B4DFF")),
			CFrame.new(0, gripY - 1.2, -4.3) * CFrame.Angles(math.rad(20), 0, 0),
		})
	elseif sub.Id == "Ninja" then
		table.insert(pieces, { weaponPart(Vector3.new(0.15, 0.3, 1.6), sub.Color), CFrame.new(0, gripY, -1) })
	else
		local orb = weaponPart(Vector3.new(1, 1, 1), sub.Color, Enum.Material.Neon, Enum.PartType.Ball)
		orb.Transparency = 0.35
		table.insert(pieces, { orb, CFrame.new(0, gripY - 0.2, 0) })
	end

	for _, piece in ipairs(pieces) do
		local part, offset = piece[1], piece[2]
		part.CFrame = hand.CFrame * offset
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = hand
		weld.Part1 = part
		weld.Parent = part
		part.Parent = model
	end
	model.Parent = character
end

---------------------------------------------------------------------------
-- จุดเกิด
---------------------------------------------------------------------------
local function pickArenaSpawn(player)
	local enemies = {}
	for _, other in ipairs(Players:GetPlayers()) do
		local character = other.Character
		if other ~= player and character and CombatService.IsAlive(character) and not CombatService.InLobby(character) then
			table.insert(enemies, character:GetPivot().Position)
		end
	end
	if #enemies == 0 then
		return arenaSpawns[math.random(1, #arenaSpawns)]
	end
	-- เลือกจุดที่ไกลจากศัตรูที่ใกล้ที่สุดมากที่สุด
	local best, bestScore
	for _, point in ipairs(arenaSpawns) do
		local nearest = math.huge
		for _, position in ipairs(enemies) do
			nearest = math.min(nearest, (position - point).Magnitude)
		end
		if not bestScore or nearest > bestScore then
			best, bestScore = point, nearest
		end
	end
	return best
end

local function placeInArena(player, character)
	local point = pickArenaSpawn(player)
	local lookAt = Vector3.new(0, point.Y, 0)
	StatusService.Clear(character)
	character:PivotTo(CFrame.lookAt(point, lookAt))
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid.Health = humanoid.MaxHealth
	end
	StatusService.Apply(character, "SpawnProtect", Config.SpawnProtection)
	for _, callback in ipairs(enterCallbacks) do
		task.spawn(callback, player, character)
	end
end

-- ลงสนาม (จากปุ่ม "ลงสนาม" หรือประตูนีออนใน Lobby)
function SpawnService.Deploy(player)
	local character = player.Character
	if not character or not CombatService.IsAlive(character) then
		return false
	end
	player:SetAttribute("InArena", true)
	SpawnService.AttachWeapon(player, character)
	placeInArena(player, character)
	return true
end

function SpawnService.ReturnToLobby(player)
	local character = player.Character
	if not character or not CombatService.IsAlive(character) then
		return false
	end
	if not player:GetAttribute("InArena") then
		return false
	end
	local sinceHit = os.clock() - CombatService.LastDamaged(character)
	if sinceHit < Config.ReturnToLobbyCombatDelay then
		Remotes.SkillFeedback:FireClient(player, {
			Type = "Notice",
			Text = "กำลังต่อสู้อยู่ ยังกลับ Lobby ไม่ได้",
		})
		return false
	end
	player:SetAttribute("InArena", false)
	StatusService.Clear(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Health = humanoid.MaxHealth
	end
	character:PivotTo(CFrame.new(Config.Lobby.Center + Vector3.new(0, 5, 0)))
	return true
end

---------------------------------------------------------------------------
-- ตั้งค่าตัวละครตอนเกิด
---------------------------------------------------------------------------
local function onCharacter(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root then
		return
	end

	humanoid.MaxHealth = Config.MaxHealth
	humanoid.Health = Config.MaxHealth
	humanoid.WalkSpeed = Config.WalkSpeed
	humanoid.UseJumpPower = true
	humanoid.JumpPower = Config.JumpPower
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None

	-- ปิดสคริปต์ฟื้นเลือดอัตโนมัติของ Roblox (เราฟื้นเลือดเองใน CombatService)
	task.spawn(function()
		local regen = character:WaitForChild("Health", 5)
		if regen and regen:IsA("Script") then
			regen:Destroy()
		end
	end)

	StatusService.SetCollisionGroup(character, Config.Groups.Players)
	character.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") and not StatusService.Has(character, "Phase") then
			descendant.CollisionGroup = Config.Groups.Players
		end
	end)

	task.spawn(buildOverhead, player, character, humanoid)

	humanoid.Died:Connect(function()
		StatusService.Clear(character)
		if player:GetAttribute("InArena") then
			CombatService.HandleDeath(player, character)
		end
	end)

	-- รอให้ตัวละครเข้า workspace เรียบร้อยก่อนย้ายตำแหน่ง
	if not character:IsDescendantOf(workspace) then
		character.AncestryChanged:Wait()
	end
	RunService.Heartbeat:Wait()
	RunService.Heartbeat:Wait()

	task.spawn(function()
		character:WaitForChild("RightHand", 3)
		if character.Parent then
			SpawnService.AttachWeapon(player, character)
		end
	end)

	if player:GetAttribute("InArena") then
		-- ตายแล้วเกิดใหม่: ใช้ชุดเดิม ลงสนามเลย
		placeInArena(player, character)
	end
end

local function onPlayer(player)
	player:SetAttribute("InArena", false)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
	player:GetAttributeChangedSignal("Subclass"):Connect(function()
		if player.Character then
			SpawnService.AttachWeapon(player, player.Character)
		end
	end)
end

function SpawnService.Init(mapInfo)
	arenaSpawns = mapInfo.ArenaSpawns

	PhysicsService:RegisterCollisionGroup(Config.Groups.Players)
	PhysicsService:RegisterCollisionGroup(Config.Groups.Phased)
	PhysicsService:CollisionGroupSetCollidable(Config.Groups.Phased, Config.Groups.Players, false)
	PhysicsService:CollisionGroupSetCollidable(Config.Groups.Phased, Config.Groups.Phased, false)

	Players.RespawnTime = Config.RespawnTime
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayer, player)
	end

	-- ประตูนีออนใน Lobby: เดินเข้าไปเพื่อลงสนาม
	local debounce = {}
	mapInfo.LobbyGate.Touched:Connect(function(hit)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if not player or player:GetAttribute("InArena") then
			return
		end
		local now = os.clock()
		if debounce[player] and now - debounce[player] < 1 then
			return
		end
		debounce[player] = now
		SpawnService.Deploy(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		debounce[player] = nil
	end)

	Remotes.ReturnToLobby.OnServerEvent:Connect(function(player)
		SpawnService.ReturnToLobby(player)
	end)

	-- ตกจากแมปแล้วตายทันที
	task.spawn(function()
		while true do
			task.wait(0.25)
			for _, player in ipairs(Players:GetPlayers()) do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if root and humanoid and humanoid.Health > 0 and root.Position.Y < Config.Arena.KillY then
					humanoid.Health = 0
				end
			end
		end
	end)
end

return SpawnService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">StatsService</string>
          <string name="Source"><![CDATA[-- leaderstats: Kills / Deaths / Streak
local Players = game:GetService("Players")

local StatsService = {}

local function getStat(player, name)
	local folder = player:FindFirstChild("leaderstats")
	return folder and folder:FindFirstChild(name)
end

local function setup(player)
	if player:FindFirstChild("leaderstats") then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	for _, name in ipairs({ "Kills", "Deaths", "Streak" }) do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = folder
	end
	folder.Parent = player
end

-- เพิ่มคิล แล้วคืนค่า streak ปัจจุบัน
function StatsService.AddKill(player)
	local kills = getStat(player, "Kills")
	local streak = getStat(player, "Streak")
	if not kills or not streak then
		return 0
	end
	kills.Value += 1
	streak.Value += 1
	return streak.Value
end

function StatsService.AddDeath(player)
	local deaths = getStat(player, "Deaths")
	local streak = getStat(player, "Streak")
	if deaths then
		deaths.Value += 1
	end
	if streak then
		streak.Value = 0
	end
end

function StatsService.Init()
	Players.PlayerAdded:Connect(setup)
	for _, player in ipairs(Players:GetPlayers()) do
		setup(player)
	end
end

return StatsService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">StatusService</string>
          <string name="Source"><![CDATA[-- สถานะผิดปกติทั้งหมด: Stun / Slow / Knockback / Airborne / Frozen / Invisible / Shield ฯลฯ
-- ทุกอย่างคำนวณฝั่ง server เท่านั้น
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local StatusService = {}

local states = {} -- [character] = { [statusName] = { Expires = number, ... } }
local pushes = {} -- [character] = เวลาหมดอายุของแรงผลัก

local INVULNERABLE = { "SpawnProtect", "DashIFrame", "Phase" }
local BLOCK_ACTION = { "Stun", "Frozen", "Airborne" }

local function getRoot(character)
	return character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(character)
	return character:FindFirstChildOfClass("Humanoid")
end

local function setCollisionGroup(character, group)
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CollisionGroup = group
		end
	end
end
StatusService.SetCollisionGroup = setCollisionGroup

-- สิ่งที่ต้องทำตอนสถานะเริ่ม / จบ
local Hooks = {}

Hooks.Frozen = {
	Start = function(character, entry)
		local root = getRoot(character)
		if root then
			entry.WasAnchored = root.Anchored
			root.Anchored = true
		end
		local highlight = Instance.new("Highlight")
		highlight.Name = "QA_Frozen"
		highlight.FillColor = Color3.fromRGB(130, 130, 130)
		highlight.FillTransparency = 0.15
		highlight.OutlineColor = Color3.fromRGB(220, 220, 220)
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.Parent = character
	end,
	End = function(character, entry)
		local root = getRoot(character)
		if root and not entry.WasAnchored then
			root.Anchored = false
			local player = Players:GetPlayerFromCharacter(character)
			if player then
				pcall(function()
					root:SetNetworkOwner(player)
				end)
			end
		end
		local highlight = character:FindFirstChild("QA_Frozen")
		if highlight then
			highlight:Destroy()
		end
	end,
}

Hooks.SpawnProtect = {
	Start = function(character)
		local ff = Instance.new("ForceField")
		ff.Name = "QA_SpawnProtect"
		ff.Visible = true
		ff.Parent = character
	end,
	End = function(character)
		local ff = character:FindFirstChild("QA_SpawnProtect")
		if ff then
			ff:Destroy()
		end
	end,
}

Hooks.Phase = {
	Start = function(character)
		setCollisionGroup(character, Config.Groups.Phased)
	end,
	End = function(character)
		setCollisionGroup(character, Config.Groups.Players)
	end,
}

Hooks.Stun = {
	End = function(character)
		-- หลังโดน Stun จะต้านทาน Stun ชั่วครู่ เพื่อไม่ให้โดนล็อกจนตาย
		StatusService.Apply(character, "StunResist", Config.Stun.ResistAfter)
	end,
}

local function refresh(character)
	local humanoid = getHumanoid(character)
	if not humanoid then
		return
	end
	local st = states[character] or {}

	local blocked = false
	for _, name in ipairs(BLOCK_ACTION) do
		if st[name] then
			blocked = true
		end
	end

	local speed = Config.WalkSpeed
	if st.Haste then
		speed *= 1 + (st.Haste.SpeedBonus or 0)
	end
	if st.Slow then
		speed *= 1 - math.clamp(st.Slow.Percent or 0, 0, 0.95)
	end
	if blocked or st.Rooted then
		speed = 0
	end

	if not character:GetAttribute("FixedSpeed") then
		humanoid.WalkSpeed = speed
		humanoid.JumpPower = (blocked or st.Rooted) and 0 or Config.JumpPower
	end

	character:SetAttribute("Invisible", st.Invisible ~= nil)
	character:SetAttribute("Shield", st.Shield and math.ceil(st.Shield.Amount or 0) or 0)
	character:SetAttribute("Stunned", st.Stun ~= nil or st.Frozen ~= nil)
end

local function endStatus(character, name)
	local st = states[character]
	if not st then
		return
	end
	local entry = st[name]
	if not entry then
		return
	end
	st[name] = nil
	local hook = Hooks[name]
	if hook and hook.End and character.Parent then
		hook.End(character, entry)
	end
end

-- ใส่สถานะ ถ้ามีอยู่แล้วจะต่อเวลา (ใช้เวลาที่นานกว่า)
function StatusService.Apply(character, name, duration, data)
	if not character or not character.Parent then
		return nil
	end
	local st = states[character]
	if not st then
		st = {}
		states[character] = st
	end
	local expires = os.clock() + duration
	local entry = st[name]
	if entry then
		entry.Expires = math.max(entry.Expires, expires)
		if data then
			for key, value in pairs(data) do
				entry[key] = value
			end
		end
	else
		entry = data or {}
		entry.Expires = expires
		st[name] = entry
		local hook = Hooks[name]
		if hook and hook.Start then
			hook.Start(character, entry)
		end
	end
	refresh(character)
	return entry
end

function StatusService.Has(character, name)
	local st = states[character]
	return st ~= nil and st[name] ~= nil
end

function StatusService.Get(character, name)
	local st = states[character]
	return st and st[name] or nil
end

function StatusService.Remove(character, name)
	if StatusService.Has(character, name) then
		endStatus(character, name)
		refresh(character)
	end
end

function StatusService.Clear(character)
	local st = states[character]
	if st then
		local names = {}
		for name in pairs(st) do
			table.insert(names, name)
		end
		for _, name in ipairs(names) do
			endStatus(character, name)
		end
	end
	states[character] = nil
	pushes[character] = nil
end

function StatusService.IsInvulnerable(character)
	local st = states[character]
	if not st then
		return false
	end
	for _, name in ipairs(INVULNERABLE) do
		if st[name] then
			return true
		end
	end
	return false
end

function StatusService.CanAct(character)
	local st = states[character]
	if not st then
		return true
	end
	for _, name in ipairs(BLOCK_ACTION) do
		if st[name] then
			return false
		end
	end
	return true
end

function StatusService.CanAttack(character)
	return StatusService.CanAct(character) and not StatusService.Has(character, "Phase")
end

---------------------------------------------------------------------------
-- สถานะแต่ละแบบ
---------------------------------------------------------------------------

local function statusVFX(character, kind, duration)
	Remotes.PlayVFX:FireAllClients("Status", { Target = character, Kind = kind, Duration = duration })
end

-- Stun: ซ้อนกันได้ไม่เกิน Config.Stun.MaxDuration และมีช่วงต้านทานหลังหลุด
function StatusService.Stun(character, duration)
	if StatusService.Has(character, "StunResist") or StatusService.IsInvulnerable(character) then
		return false
	end
	local now = os.clock()
	local entry = StatusService.Get(character, "Stun")
	local remaining = entry and math.max(0, entry.Expires - now) or 0
	local total = math.min(remaining + duration, Config.Stun.MaxDuration)
	if entry then
		entry.Expires = now + total
	else
		StatusService.Apply(character, "Stun", total)
	end
	statusVFX(character, "Stun", total)
	return true
end

function StatusService.Slow(character, percent, duration)
	if StatusService.IsInvulnerable(character) then
		return
	end
	local entry = StatusService.Get(character, "Slow")
	if entry then
		percent = math.max(percent, entry.Percent or 0)
	end
	StatusService.Apply(character, "Slow", duration, { Percent = percent })
end

function StatusService.Freeze(character, duration)
	if StatusService.IsInvulnerable(character) then
		return
	end
	StatusService.Apply(character, "Frozen", duration)
end

function StatusService.Haste(character, speedBonus, duration)
	StatusService.Apply(character, "Haste", duration, { SpeedBonus = speedBonus })
	statusVFX(character, "Haste", duration)
end

function StatusService.SetInvisible(character, duration)
	StatusService.Apply(character, "Invisible", duration)
end

function StatusService.Shield(character, amount, duration, reflect)
	StatusService.Remove(character, "Shield")
	StatusService.Apply(character, "Shield", duration, { Amount = amount, Reflect = reflect })
	statusVFX(character, "Shield", duration)
end

-- หักดาเมจออกจากโล่ คืนค่า (ดาเมจที่เหลือ, ค่าดาเมจสะท้อน หรือ nil)
function StatusService.AbsorbShield(character, damage)
	local entry = StatusService.Get(character, "Shield")
	if not entry then
		return damage, nil
	end
	local absorbed = math.min(entry.Amount, damage)
	entry.Amount -= absorbed
	local reflect = entry.Reflect
	if entry.Amount <= 0 then
		StatusService.Remove(character, "Shield")
	else
		refresh(character)
	end
	return damage - absorbed, reflect
end

-- แรงผลักชั่วคราวด้วย LinearVelocity (server สร้าง, client ที่เป็นเจ้าของร่างจำลองฟิสิกส์)
function StatusService.Push(character, velocity, duration)
	local root = getRoot(character)
	if not root or root.Anchored then
		return
	end
	local attachment = root:FindFirstChild("QA_PushAttachment")
	if not attachment then
		attachment = Instance.new("Attachment")
		attachment.Name = "QA_PushAttachment"
		attachment.Parent = root
	end
	local mover = root:FindFirstChild("QA_Push")
	if not mover then
		mover = Instance.new("LinearVelocity")
		mover.Name = "QA_Push"
		mover.Attachment0 = attachment
		mover.RelativeTo = Enum.ActuatorRelativeTo.World
		mover.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
		-- จำกัดแรงไว้ เพื่อไม่ให้ดันตัวละครทะลุกำแพง
		mover.ForceLimitsEnabled = true
		mover.MaxForce = 200000
		mover.Parent = root
	end
	mover.VectorVelocity = velocity
	pushes[character] = os.clock() + duration
end

function StatusService.StopPush(character)
	pushes[character] = nil
	local root = getRoot(character)
	local mover = root and root:FindFirstChild("QA_Push")
	if mover then
		mover:Destroy()
	end
end

function StatusService.Knockback(character, velocity, duration)
	if StatusService.IsInvulnerable(character) then
		return
	end
	StatusService.Push(character, velocity, duration or 0.25)
end

-- ลอยกลางอากาศ: ดันขึ้นแล้วใช้สกิลไม่ได้ตลอดช่วงเวลา
function StatusService.Airborne(character, duration, upSpeed)
	if StatusService.IsInvulnerable(character) then
		return
	end
	StatusService.Apply(character, "Airborne", duration)
	StatusService.Push(character, Vector3.new(0, upSpeed or 45, 0), math.min(0.35, duration))
end

---------------------------------------------------------------------------
-- วนตรวจหมดอายุ
---------------------------------------------------------------------------

RunService.Heartbeat:Connect(function()
	local now = os.clock()
	for character, st in pairs(states) do
		if not character.Parent then
			states[character] = nil
		else
			local expired
			for name, entry in pairs(st) do
				if entry.Expires <= now then
					expired = expired or {}
					table.insert(expired, name)
				end
			end
			if expired then
				for _, name in ipairs(expired) do
					endStatus(character, name)
				end
				refresh(character)
			end
		end
	end
	for character, expires in pairs(pushes) do
		if expires <= now or not character.Parent then
			StatusService.StopPush(character)
		end
	end
end)

return StatusService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="38">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="39">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">40</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="40">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="41">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">InputController</string>
            <string name="Source"><![CDATA[-- รับปุ่มจากคีย์บอร์ด / เมาส์ / จอย / ปุ่มมือถือ แล้วส่ง "ขอใช้สกิล + จุดที่เล็ง" ให้ server
-- (client ไม่ตัดสินดาเมจ/คูลดาวน์เอง ค่าคูลดาวน์ที่เก็บไว้นี้ใช้แสดงผลและกันสแปมเท่านั้น)
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Classes = require(Shared:WaitForChild("Classes"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local player = Players.LocalPlayer

local InputController = {}

InputController.Cooldowns = {} -- [key] = { Remaining, Total }
InputController.Rate = 1
InputController.IsTouch = UserInputService.TouchEnabled

local KEYS = { "0", "1", "2", "3", "dash" }
for _, key in ipairs(KEYS) do
	InputController.Cooldowns[key] = { Remaining = 0, Total = 1 }
end

local menuHandler -- ตั้งโดย Main (เปิด/ปิดหน้าเลือกสาย)
local blocked = function()
	return false
end
local holdingBasic = false
local lastSend = 0

function InputController.SetMenuHandler(callback)
	menuHandler = callback
end

-- ฟังก์ชันที่บอกว่าตอนนี้ห้ามรับปุ่มต่อสู้ไหม (เช่น หน้าเลือกสายเปิดอยู่)
function InputController.SetBlocked(callback)
	blocked = callback
end

function InputController.GetSubclass()
	return Classes.GetSubclass(player:GetAttribute("Subclass"))
end

local function getCharacter()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then
		return character, humanoid, root
	end
	return nil
end

-- จุดที่เล็ง: คอมใช้ตำแหน่งเมาส์ มือถือ/จอยใช้ทิศที่กล้องหัน (กลางจอ)
function InputController.GetAimPosition()
	local camera = Workspace.CurrentCamera
	local character, _, root = getCharacter()
	if not camera or not character then
		return Vector3.zero
	end

	local useMouse = UserInputService.MouseEnabled
		and UserInputService:GetLastInputType() ~= Enum.UserInputType.Touch
		and not tostring(UserInputService:GetLastInputType()):find("Gamepad")
	local ray
	if useMouse then
		local location = UserInputService:GetMouseLocation()
		ray = camera:ViewportPointToRay(location.X, location.Y)
	else
		local size = camera.ViewportSize
		ray = camera:ViewportPointToRay(size.X / 2, size.Y / 2)
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = { character }
	for _, name in ipairs({ "LocalEffects", "Effects" }) do
		local folder = Workspace:FindFirstChild(name)
		if folder then
			table.insert(exclude, folder)
		end
	end
	params.FilterDescendantsInstances = exclude

	local result = Workspace:Raycast(ray.Origin, ray.Direction * 600, params)
	if result then
		return result.Position
	end
	if not useMouse then
		-- มองขึ้นฟ้า: ใช้ทิศกล้องแนวราบ
		local look = camera.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 0.05 then
			return root.Position + flat.Unit * 60
		end
	end
	return ray.Origin + ray.Direction * 300
end

-- ขอใช้สกิล: slot = 0 (โจมตีปกติ), 1–3, "dash"
function InputController.Trigger(slot)
	if blocked() or not player:GetAttribute("InArena") then
		return
	end
	local character, _, root = getCharacter()
	if not character then
		return
	end
	local key = tostring(slot)
	local cooldown = InputController.Cooldowns[key]
	if not cooldown or cooldown.Remaining > 0.03 then
		return
	end
	local now = os.clock()
	if now - lastSend < 0.06 then
		return
	end
	lastSend = now

	local aim = InputController.GetAimPosition()

	-- หันตัวไปทางที่เล็ง (เฉพาะภาพ ผลจริง server คิดเอง)
	if slot ~= "dash" and not character:GetAttribute("Stunned") then
		local flat = Vector3.new(aim.X - root.Position.X, 0, aim.Z - root.Position.Z)
		if flat.Magnitude > 1 and not root.Anchored then
			root.CFrame = CFrame.lookAt(root.Position, root.Position + flat.Unit)
		end
	end

	-- กันกดรัวระหว่างรอ server ตอบ (server จะส่งค่าคูลดาวน์จริงมาทับ)
	local sub = InputController.GetSubclass()
	if slot == 0 and sub then
		cooldown.Remaining = sub.Basic.Cooldown
		cooldown.Total = sub.Basic.Cooldown
	else
		cooldown.Remaining = math.max(cooldown.Remaining, 0.25)
	end

	Remotes.UseSkill:FireServer(slot, aim)
end

function InputController.SetHoldingBasic(holding)
	holdingBasic = holding
	if holding then
		InputController.Trigger(0)
	end
end

function InputController.OpenMenu()
	if player:GetAttribute("InArena") then
		Remotes.ReturnToLobby:FireServer()
	elseif menuHandler then
		menuHandler()
	end
end

---------------------------------------------------------------------------
-- กระโดด 2 ครั้ง (ความสามารถติดตัวของนินจา)
---------------------------------------------------------------------------
local function setupDoubleJump()
	local usedDouble = false
	local lastJump = 0

	local function bind(character)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if not humanoid then
			return
		end
		usedDouble = false
		humanoid.StateChanged:Connect(function(_, new)
			if new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then
				usedDouble = false
			elseif new == Enum.HumanoidStateType.Jumping then
				lastJump = os.clock()
			end
		end)
	end
	player.CharacterAdded:Connect(bind)
	if player.Character then
		task.spawn(bind, player.Character)
	end

	UserInputService.JumpRequest:Connect(function()
		local sub = InputController.GetSubclass()
		if not sub or not sub.DoubleJump or usedDouble then
			return
		end
		local character, humanoid = getCharacter()
		if not character or character:GetAttribute("Stunned") then
			return
		end
		local state = humanoid:GetState()
		local inAir = state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping
		if inAir and os.clock() - lastJump > 0.22 then
			usedDouble = true
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end)
end

function InputController.Init()
	-- คูลดาวน์จริงจาก server
	Remotes.SkillFeedback.OnClientEvent:Connect(function(message)
		if type(message) ~= "table" or message.Type ~= "Cooldowns" then
			return
		end
		InputController.Rate = message.Rate or 1
		for _, key in ipairs(KEYS) do
			local entry = InputController.Cooldowns[key]
			entry.Remaining = (message.Remaining and message.Remaining[key]) or 0
			entry.Total = (message.Totals and message.Totals[key]) or 1
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		for _, key in ipairs(KEYS) do
			local entry = InputController.Cooldowns[key]
			if entry.Remaining > 0 then
				entry.Remaining = math.max(0, entry.Remaining - dt * InputController.Rate)
			end
		end
		if holdingBasic then
			InputController.Trigger(0)
		end
	end)

	-- ใช้ ContextActionService เพื่อให้คีย์บอร์ด/จอย/ปุ่มมือถือใช้ลอจิกเดียวกัน
	local function skillAction(slot)
		return function(_, state)
			if state == Enum.UserInputState.Begin then
				InputController.Trigger(slot)
			end
			return Enum.ContextActionResult.Pass
		end
	end

	ContextActionService:BindAction("QA_Basic", function(_, state)
		if state == Enum.UserInputState.Begin then
			InputController.SetHoldingBasic(true)
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			InputController.SetHoldingBasic(false)
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)

	ContextActionService:BindAction("QA_Skill1", skillAction(1), false, Enum.KeyCode.Q, Enum.KeyCode.ButtonX)
	ContextActionService:BindAction("QA_Skill2", skillAction(2), false, Enum.KeyCode.E, Enum.KeyCode.ButtonY)
	ContextActionService:BindAction("QA_Skill3", skillAction(3), false, Enum.KeyCode.R, Enum.KeyCode.ButtonB)
	ContextActionService:BindAction("QA_Dash", skillAction("dash"), false, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL2)

	ContextActionService:BindActionAtPriority("QA_Menu", function(_, state)
		if state == Enum.UserInputState.Begin then
			InputController.OpenMenu()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.Tab, Enum.KeyCode.ButtonSelect)

	setupDoubleJump()
end

return InputController
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="43">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- จุดเริ่มต้นฝั่ง client
local Client = script.Parent

local InputController = require(Client.InputController)
local VFXController = require(Client.VFXController)
local LoadoutUI = require(Client.UI.LoadoutUI)
local HUD = require(Client.UI.HUD)
local KillFeed = require(Client.UI.KillFeed)
local MobileButtons = require(Client.UI.MobileButtons)

VFXController.Init()
LoadoutUI.Init()
HUD.Init(InputController)
KillFeed.Init()

InputController.SetMenuHandler(LoadoutUI.Toggle)
InputController.SetBlocked(LoadoutUI.IsOpen)
InputController.Init()
MobileButtons.Init(InputController)
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="44">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[-- HUD: แถบเลือด, ช่องสกิล + คูลดาวน์, ไอคอนพุ่งหลบ, ชื่อสายย่อย, ข้อความแจ้งเตือน
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Classes = require(Shared:WaitForChild("Classes"))
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Theme = require(script.Parent.Theme)
local New = Theme.New

local player = Players.LocalPlayer

local HUD = {}

local SLOT_SIZE = 74

-- ช่องสกิลทรงกลม พร้อมม่านคูลดาวน์แบบทึบที่ค่อย ๆ ลดลง
local function makeSlot(parent, keyText, order)
	local slot = New("Frame", {
		Name = "Slot" .. keyText,
		LayoutOrder = order,
		Size = UDim2.fromOffset(SLOT_SIZE, SLOT_SIZE),
		BackgroundColor3 = Theme.Panel,
		Parent = parent,
	}, {
		Theme.Round(),
		New("UIAspectRatioConstraint", { AspectRatio = 1 }),
	})
	local stroke = Theme.Stroke(Theme.Accent, 3)
	stroke.Parent = slot

	local icon = Theme.Label({
		Name = "Icon",
		Size = UDim2.fromScale(1, 1),
		Font = Theme.FontBold,
		TextSize = 34,
		Text = "",
		Parent = slot,
	})

	-- ม่านคูลดาวน์: กรอบตัดขอบที่สูงตามสัดส่วนเวลาที่เหลือ ข้างในเป็นวงกลมทึบ
	local clip = New("Frame", {
		Name = "CooldownClip",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		ZIndex = 2,
		Parent = slot,
	})
	New("Frame", {
		Name = "Shade",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromOffset(SLOT_SIZE, SLOT_SIZE),
		BackgroundColor3 = Color3.fromRGB(5, 5, 10),
		BackgroundTransparency = 0.15,
		ZIndex = 2,
		Parent = clip,
	}, { Theme.Round() })

	local timer = Theme.Label({
		Name = "Timer",
		Size = UDim2.fromScale(1, 1),
		Font = Theme.FontBlack,
		TextSize = 26,
		Text = "",
		ZIndex = 3,
		Parent = slot,
	})

	local key = Theme.Label({
		Name = "Key",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 4),
		Size = UDim2.fromOffset(SLOT_SIZE + 30, 18),
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.SubText,
		TextWrapped = false,
		Text = keyText,
		Parent = slot,
	})

	return { Frame = slot, Stroke = stroke, Icon = icon, Clip = clip, Timer = timer, Key = key }
end

local function setCooldown(slot, entry)
	if entry and entry.Remaining > 0.05 then
		slot.Clip.Size = UDim2.fromScale(1, math.clamp(entry.Remaining / math.max(entry.Total, 0.05), 0, 1))
		slot.Timer.Text = entry.Total >= 1 and string.format(entry.Remaining >= 10 and "%d" or "%.1f", entry.Remaining) or ""
	else
		slot.Clip.Size = UDim2.fromScale(1, 0)
		slot.Timer.Text = ""
	end
end

function HUD.Init(InputController)
	local gui = New("ScreenGui", {
		Name = "QA_HUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local root = Theme.ScaledRoot(gui)
	local isTouch = InputController.IsTouch

	-----------------------------------------------------------------------
	-- แถบล่าง: ชื่อสาย + ช่องสกิล + แถบเลือด
	-----------------------------------------------------------------------
	local bottom = New("Frame", {
		Name = "Bottom",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(460, 190),
		Parent = root,
	})

	local subLabel = Theme.Label({
		Name = "Subclass",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -40),
		Size = UDim2.fromOffset(460, 24),
		Font = Theme.FontBold,
		TextSize = 18,
		TextStrokeTransparency = 0.5,
		Text = "",
		Parent = bottom,
	})

	local slotRow = New("Frame", {
		Name = "Slots",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -92),
		Size = UDim2.fromOffset(460, SLOT_SIZE),
		Visible = not isTouch, -- มือถือมีปุ่มบนจอที่แสดงคูลดาวน์อยู่แล้ว
		Parent = bottom,
	}, {
		New("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 18),
		}),
	})

	local slots = {
		dash = makeSlot(slotRow, "Shift", 1),
		["1"] = makeSlot(slotRow, "Q", 2),
		["2"] = makeSlot(slotRow, "E", 3),
		["3"] = makeSlot(slotRow, "R", 4),
	}
	slots.dash.Icon.Text = "💨"
	slots.dash.Stroke.Color = Theme.SubText

	local barBack = New("Frame", {
		Name = "Health",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromOffset(420, 28),
		BackgroundColor3 = Color3.fromRGB(16, 17, 26),
		Parent = bottom,
	}, { Theme.Corner(8), Theme.Stroke(Color3.fromRGB(70, 75, 100), 2) })

	local ghost = New("Frame", {
		Name = "Ghost",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.4,
		Parent = barBack,
	}, { Theme.Corner(8) })
	local fill = New("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(70, 220, 110),
		Parent = barBack,
	}, { Theme.Corner(8) })
	local healthText = Theme.Label({
		Name = "Text",
		Size = UDim2.fromScale(1, 1),
		Font = Theme.FontBold,
		TextSize = 16,
		TextStrokeTransparency = 0.4,
		Text = "",
		ZIndex = 3,
		Parent = barBack,
	})

	local ammoLabel = Theme.Label({
		Name = "Ammo",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(1, 14, 1, 0),
		Size = UDim2.fromOffset(170, 28),
		Font = Theme.FontBold,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextStrokeTransparency = 0.5,
		Text = "",
		Parent = barBack,
	})

	-----------------------------------------------------------------------
	-- ข้อความกลางจอ / ประกาศ / คำแนะนำ
	-----------------------------------------------------------------------
	local notice = Theme.Label({
		Name = "Notice",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.68),
		Size = UDim2.fromOffset(600, 30),
		Font = Theme.FontBold,
		TextSize = 20,
		TextColor3 = Color3.fromRGB(255, 200, 90),
		TextStrokeTransparency = 0.4,
		TextTransparency = 1,
		Text = "",
		Parent = root,
	})

	local announce = Theme.Label({
		Name = "Announce",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 96),
		Size = UDim2.fromOffset(900, 44),
		Font = Theme.FontBlack,
		TextSize = 32,
		TextStrokeTransparency = 0.2,
		TextTransparency = 1,
		Text = "",
		Parent = root,
	})

	local hint = Theme.Label({
		Name = "Hint",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(700, 26),
		TextSize = 17,
		TextColor3 = Theme.SubText,
		TextStrokeTransparency = 0.6,
		Text = isTouch and "แตะ ☰ เพื่อเลือกสาย หรือเดินเข้าประตูนีออนเพื่อลงสนาม"
			or "กด Tab เพื่อเลือกสาย หรือเดินเข้าประตูนีออนเพื่อลงสนาม",
		Parent = root,
	})

	local respawn = Theme.Label({
		Name = "Respawn",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromOffset(600, 50),
		Font = Theme.FontBlack,
		TextSize = 34,
		TextColor3 = Theme.Danger,
		TextStrokeTransparency = 0.2,
		Visible = false,
		Text = "",
		Parent = root,
	})

	local function showNotice(text)
		notice.Text = text
		notice.TextTransparency = 0
		notice.TextStrokeTransparency = 0.4
		TweenService:Create(notice, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 1.2), {
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		}):Play()
	end
	HUD.ShowNotice = showNotice

	-----------------------------------------------------------------------
	-- อัปเดตข้อมูลสาย / เลือด
	-----------------------------------------------------------------------
	local function refreshLoadout()
		local sub = Classes.GetSubclass(player:GetAttribute("Subclass"))
		if not sub then
			return
		end
		local color = Theme.Readable(sub.Color)
		subLabel.Text = string.format("%s %s", sub.Icon or "", sub.DisplayName)
		subLabel.TextColor3 = color
		for i = 1, 3 do
			local skill = sub.SkillById[player:GetAttribute("Skill" .. i) or ""]
			local slot = slots[tostring(i)]
			slot.Icon.Text = skill and skill.Icon or "?"
			slot.Stroke.Color = color
			if not isTouch then
				slot.Key.Text = string.format("%s  %s", ({ "Q", "E", "R" })[i], skill and skill.Name or "")
			end
		end
	end
	for _, name in ipairs({ "Subclass", "Skill1", "Skill2", "Skill3" }) do
		player:GetAttributeChangedSignal(name):Connect(refreshLoadout)
	end
	refreshLoadout()

	local function refreshArena()
		local inArena = player:GetAttribute("InArena") == true
		bottom.Visible = inArena
		hint.Visible = not inArena
	end
	player:GetAttributeChangedSignal("InArena"):Connect(refreshArena)
	refreshArena()

	local function refreshAmmo()
		local ammo = player:GetAttribute("Ammo")
		if player:GetAttribute("Reloading") then
			ammoLabel.Text = "🔄 กำลังรีโหลด..."
		elseif ammo then
			ammoLabel.Text = string.format("🔫 %d / 20", ammo)
		else
			ammoLabel.Text = ""
		end
	end
	player:GetAttributeChangedSignal("Ammo"):Connect(refreshAmmo)
	player:GetAttributeChangedSignal("Reloading"):Connect(refreshAmmo)

	local function bindCharacter(character)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if not humanoid then
			return
		end
		respawn.Visible = false
		local function update()
			local maxHealth = math.max(humanoid.MaxHealth, 1)
			local ratio = math.clamp(humanoid.Health / maxHealth, 0, 1)
			healthText.Text = string.format("%d / %d", math.ceil(humanoid.Health), maxHealth)
			fill.BackgroundColor3 = Color3.fromRGB(70, 220, 110):Lerp(Color3.fromRGB(240, 70, 70), 1 - ratio)
			TweenService:Create(fill, TweenInfo.new(0.15), { Size = UDim2.fromScale(ratio, 1) }):Play()
			TweenService:Create(ghost, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, 0.15), {
				Size = UDim2.fromScale(ratio, 1),
			}):Play()
		end
		humanoid.HealthChanged:Connect(update)
		humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(update)
		update()
		humanoid.Died:Connect(function()
			respawn.Visible = true
			for remaining = Config.RespawnTime, 1, -1 do
				if player.Character ~= character then
					break
				end
				respawn.Text = string.format("คุณตายแล้ว — เกิดใหม่ใน %d", remaining)
				task.wait(1)
			end
			respawn.Visible = false
		end)
	end
	player.CharacterAdded:Connect(bindCharacter)
	if player.Character then
		task.spawn(bindCharacter, player.Character)
	end

	-----------------------------------------------------------------------
	-- ข้อความจาก server
	-----------------------------------------------------------------------
	Remotes.SkillFeedback.OnClientEvent:Connect(function(message)
		if type(message) ~= "table" then
			return
		end
		if message.Type == "Denied" and message.Reason then
			showNotice(message.Reason)
		elseif message.Type == "Notice" and message.Text then
			showNotice(message.Text)
		end
	end)

	Remotes.Announce.OnClientEvent:Connect(function(text, color)
		announce.Text = tostring(text)
		announce.TextColor3 = typeof(color) == "Color3" and Theme.Readable(color) or Theme.Text
		announce.TextTransparency = 0
		announce.TextStrokeTransparency = 0.2
		TweenService:Create(announce, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 3), {
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		}):Play()
	end)

	RunService.RenderStepped:Connect(function()
		for key, slot in pairs(slots) do
			setCooldown(slot, InputController.Cooldowns[key])
		end
	end)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">KillFeed</string>
              <string name="Source"><![CDATA[-- Kill feed มุมขวาบน: "[ผู้ฆ่า] ⚡ [ชื่อสกิล] → [ผู้ตาย]" แสดง 5 บรรทัดล่าสุด หายไปใน 6 วิ
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Theme = require(script.Parent.Theme)
local New = Theme.New

local player = Players.LocalPlayer

local KillFeed = {}

function KillFeed.Init()
	local gui = New("ScreenGui", {
		Name = "QA_KillFeed",
		ResetOnSpawn = false,
		DisplayOrder = 4,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local root = Theme.ScaledRoot(gui)

	local list = New("Frame", {
		Name = "List",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 190),
		Size = UDim2.fromOffset(440, 200),
		Parent = root,
	}, {
		New("UIListLayout", {
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 5),
		}),
	})

	local lines = {}
	local counter = 0

	local function removeLine(line)
		local index = table.find(lines, line)
		if index then
			table.remove(lines, index)
		end
		line:Destroy()
	end

	local function addLine(text, highlight)
		counter += 1
		local line = New("TextLabel", {
			LayoutOrder = counter,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 30),
			BackgroundColor3 = highlight and Color3.fromRGB(70, 30, 40) or Theme.Background,
			BackgroundTransparency = 0.25,
			Font = Theme.FontBold,
			TextSize = 16,
			TextColor3 = Theme.Text,
			RichText = true,
			Text = text,
			Parent = list,
		}, {
			Theme.Corner(6),
			New("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }),
		})
		table.insert(lines, line)
		while #lines > Config.KillFeed.MaxLines do
			removeLine(lines[1])
		end
		task.delay(Config.KillFeed.Lifetime - 0.5, function()
			if line.Parent then
				TweenService:Create(line, TweenInfo.new(0.5), { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
				task.wait(0.5)
				if line.Parent then
					removeLine(line)
				end
			end
		end)
	end

	-- กันอักขระพิเศษของ RichText ในชื่อผู้เล่น
	local function escape(text)
		return (tostring(text):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
	end

	Remotes.KillFeed.OnClientEvent:Connect(function(killer, victim, skillName, assists)
		local mine = killer == player.DisplayName or victim == player.DisplayName
		local text
		if killer then
			text = string.format(
				'<font color="#7CFFB2">%s</font> ⚡ <font color="#FFD45A">%s</font> → <font color="#FF7A85">%s</font>',
				escape(killer),
				escape(skillName or "โจมตี"),
				escape(victim)
			)
			if type(assists) == "table" and #assists > 0 then
				local names = {}
				for _, name in ipairs(assists) do
					table.insert(names, escape(name))
				end
				text ..= string.format(' <font color="#A5ACC8">(ช่วย: %s)</font>', table.concat(names, ", "))
			end
		else
			text = string.format('☠ <font color="#FF7A85">%s</font> %s', escape(victim), escape(skillName or "ตาย"))
		end
		addLine(text, mine)
	end)
end

return KillFeed
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">LoadoutUI</string>
              <string name="Source"><![CDATA[-- หน้าเลือกสาย 3 ขั้น: สายใหญ่ → สายย่อย → สกิล 3 จาก 5
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Classes = require(Shared:WaitForChild("Classes"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Theme = require(script.Parent.Theme)
local New = Theme.New

local player = Players.LocalPlayer

local LoadoutUI = {}

local gui, content, titleLabel, subtitleLabel, backButton, errorLabel, footer
local isOpen = false
local step = 1
local chosenCategory, chosenSubclass
local chosenSkills = {} -- ลำดับที่กด = ช่อง Q / E / R
local SLOT_KEYS = { "Q", "E", "R" }

local render -- ประกาศล่วงหน้า

local function clear(frame)
	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

-- การ์ดกดได้ พร้อมแถบสีด้านบน
local function card(parent, size, color, order)
	local button = New("TextButton", {
		LayoutOrder = order,
		Size = size,
		BackgroundColor3 = Theme.Panel,
		AutoButtonColor = false,
		Text = "",
		Parent = parent,
	}, {
		Theme.Corner(14),
		New("UIAspectRatioConstraint", { AspectRatio = size.X.Offset / size.Y.Offset }),
	})
	local stroke = Theme.Stroke(color, 2, 0.35)
	stroke.Parent = button
	New("Frame", {
		Name = "Stripe",
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = button,
	}, { Theme.Corner(14) })
	button.MouseEnter:Connect(function()
		button.BackgroundColor3 = Theme.PanelLight
	end)
	button.MouseLeave:Connect(function()
		button.BackgroundColor3 = Theme.Panel
	end)
	return button, stroke
end

local function text(parent, props)
	props.Parent = parent
	return Theme.Label(props)
end

---------------------------------------------------------------------------
-- ขั้น 1: สายใหญ่
---------------------------------------------------------------------------
local function renderCategories()
	titleLabel.Text = "เลือกสายใหญ่"
	subtitleLabel.Text = "ขั้นที่ 1 / 3"
	for index, category in ipairs(Classes.Categories) do
		local color = Theme.Readable(category.Color)
		local button = card(content, UDim2.fromOffset(330, 400), color, index)
		text(button, { Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 0, 110), TextSize = 84, Text = category.Icon })
		text(button, {
			Position = UDim2.fromOffset(0, 150),
			Size = UDim2.new(1, 0, 0, 44),
			Font = Theme.FontBlack,
			TextSize = 36,
			TextColor3 = color,
			Text = category.DisplayName,
		})
		text(button, {
			Position = UDim2.fromOffset(24, 200),
			Size = UDim2.new(1, -48, 0, 70),
			TextSize = 18,
			TextColor3 = Theme.SubText,
			Text = category.Description,
		})
		local names = {}
		for _, subId in ipairs(category.Subclasses) do
			local sub = Classes.Subclasses[subId]
			table.insert(names, string.format("%s %s", sub.Icon or "", sub.DisplayName))
		end
		text(button, {
			Position = UDim2.fromOffset(24, 284),
			Size = UDim2.new(1, -48, 0, 96),
			Font = Theme.FontBold,
			TextSize = 19,
			Text = table.concat(names, "\n"),
		})
		button.Activated:Connect(function()
			chosenCategory = category
			step = 2
			render()
		end)
	end
end

---------------------------------------------------------------------------
-- ขั้น 2: สายย่อย
---------------------------------------------------------------------------
local function renderSubclasses()
	titleLabel.Text = string.format("%s %s — เลือกสายย่อย", chosenCategory.Icon, chosenCategory.DisplayName)
	subtitleLabel.Text = "ขั้นที่ 2 / 3"
	for index, subId in ipairs(chosenCategory.Subclasses) do
		local sub = Classes.Subclasses[subId]
		local color = Theme.Readable(sub.Color)
		local button = card(content, UDim2.fromOffset(330, 400), color, index)
		text(button, { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 96), TextSize = 72, Text = sub.Icon or "" })
		text(button, {
			Position = UDim2.fromOffset(0, 132),
			Size = UDim2.new(1, 0, 0, 42),
			Font = Theme.FontBlack,
			TextSize = 32,
			TextColor3 = color,
			Text = sub.DisplayName,
		})
		text(button, {
			Position = UDim2.fromOffset(24, 180),
			Size = UDim2.new(1, -48, 0, 78),
			TextSize = 18,
			TextColor3 = Theme.SubText,
			Text = sub.Description,
		})
		local basic = sub.Basic
		local damage = type(basic.Damage) == "table" and table.concat(basic.Damage, "/") or tostring(basic.Damage)
		New("Frame", {
			Position = UDim2.fromOffset(20, 272),
			Size = UDim2.new(1, -40, 0, 104),
			BackgroundColor3 = Theme.Background,
			BackgroundTransparency = 0.3,
			Parent = button,
		}, {
			Theme.Corner(10),
			Theme.Label({
				Position = UDim2.fromOffset(12, 8),
				Size = UDim2.new(1, -24, 0, 24),
				Font = Theme.FontBold,
				TextSize = 17,
				TextXAlignment = Enum.TextXAlignment.Left,
				Text = "โจมตีปกติ: " .. basic.Name,
			}),
			Theme.Label({
				Position = UDim2.fromOffset(12, 36),
				Size = UDim2.new(1, -24, 0, 60),
				TextSize = 16,
				TextColor3 = Theme.SubText,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				Text = string.format("DMG %s   ระยะ %d%s", damage, basic.Range, sub.DoubleJump and "\n+ กระโดดได้ 2 ครั้ง" or ""),
			}),
		})
		button.Activated:Connect(function()
			if chosenSubclass ~= sub then
				chosenSkills = {}
			end
			chosenSubclass = sub
			step = 3
			render()
		end)
	end
end

---------------------------------------------------------------------------
-- ขั้น 3: สกิล 3 จาก 5
---------------------------------------------------------------------------
local function renderSkills()
	local sub = chosenSubclass
	local color = Theme.Readable(sub.Color)
	titleLabel.Text = string.format("%s %s — เลือกสกิล 3 จาก 5", sub.Icon or "", sub.DisplayName)
	subtitleLabel.Text = "ขั้นที่ 3 / 3 · ลำดับที่กด = ช่อง Q / E / R"

	local badges = {}
	local strokes = {}
	local deployButton

	local function refresh()
		for skillId, badge in pairs(badges) do
			local index = table.find(chosenSkills, skillId)
			badge.Visible = index ~= nil
			badge.Text = index and string.format("%d · %s", index, SLOT_KEYS[index]) or ""
			strokes[skillId].Transparency = index and 0 or 0.6
			strokes[skillId].Thickness = index and 4 or 2
		end
		local ready = #chosenSkills == 3
		deployButton.BackgroundColor3 = ready and color or Theme.PanelLight
		deployButton.TextColor3 = ready and Color3.fromRGB(10, 10, 16) or Theme.SubText
		deployButton.Text = ready and "⚔ ลงสนาม" or string.format("เลือกอีก %d สกิล", 3 - #chosenSkills)
	end

	for index, skill in ipairs(sub.Skills) do
		local button, stroke = card(content, UDim2.fromOffset(226, 400), color, index)
		strokes[skill.Id] = stroke
		text(button, { Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 70), TextSize = 52, Text = skill.Icon or "" })
		text(button, {
			Position = UDim2.fromOffset(8, 100),
			Size = UDim2.new(1, -16, 0, 52),
			Font = Theme.FontBold,
			TextSize = 22,
			TextColor3 = color,
			Text = skill.Name,
		})
		text(button, {
			Position = UDim2.fromOffset(14, 156),
			Size = UDim2.new(1, -28, 0, 150),
			TextSize = 15,
			TextColor3 = Theme.SubText,
			TextYAlignment = Enum.TextYAlignment.Top,
			Text = skill.Description,
		})
		New("Frame", {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -14),
			Size = UDim2.new(1, -24, 0, 66),
			BackgroundColor3 = Theme.Background,
			BackgroundTransparency = 0.3,
			Parent = button,
		}, {
			Theme.Corner(10),
			Theme.Label({
				Position = UDim2.fromOffset(0, 6),
				Size = UDim2.new(1, 0, 0, 26),
				Font = Theme.FontBold,
				TextSize = 17,
				Text = "DMG " .. (skill.DamageText or "–"),
			}),
			Theme.Label({
				Position = UDim2.fromOffset(0, 34),
				Size = UDim2.new(1, 0, 0, 26),
				Font = Theme.FontBold,
				TextSize = 17,
				TextColor3 = Color3.fromRGB(140, 200, 255),
				Text = string.format("CD %d วิ", skill.Cooldown),
			}),
		})
		badges[skill.Id] = Theme.Label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 18),
			Size = UDim2.fromOffset(74, 32),
			BackgroundTransparency = 0,
			BackgroundColor3 = color,
			Font = Theme.FontBlack,
			TextSize = 18,
			TextColor3 = Color3.fromRGB(10, 10, 16),
			Visible = false,
			ZIndex = 3,
			Parent = button,
		})
		Theme.Corner(8).Parent = badges[skill.Id]

		button.Activated:Connect(function()
			local existing = table.find(chosenSkills, skill.Id)
			if existing then
				table.remove(chosenSkills, existing)
			elseif #chosenSkills < 3 then
				table.insert(chosenSkills, skill.Id)
			end
			errorLabel.Text = ""
			refresh()
		end)
	end

	deployButton = New("TextButton", {
		Name = "Deploy",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(340, 62),
		Font = Theme.FontBlack,
		TextSize = 26,
		AutoButtonColor = true,
		Parent = footer,
	}, { Theme.Corner(14) })
	deployButton.Activated:Connect(function()
		if #chosenSkills ~= 3 then
			return
		end
		errorLabel.Text = ""
		Remotes.SelectLoadout:FireServer(sub.Id, { chosenSkills[1], chosenSkills[2], chosenSkills[3] })
	end)
	refresh()
end

function render()
	clear(content)
	clear(footer)
	errorLabel.Text = ""
	backButton.Visible = step > 1
	if step == 1 then
		renderCategories()
	elseif step == 2 then
		renderSubclasses()
	else
		renderSkills()
	end
end

---------------------------------------------------------------------------
-- เปิด / ปิด
---------------------------------------------------------------------------
function LoadoutUI.IsOpen()
	return isOpen
end

function LoadoutUI.Open()
	if isOpen or player:GetAttribute("InArena") then
		return
	end
	isOpen = true
	-- ถ้ามีชุดเดิมอยู่ ให้เปิดที่ขั้นเลือกสกิลของสายเดิมพร้อมติ๊กสกิลเดิมไว้
	local sub = Classes.GetSubclass(player:GetAttribute("Subclass"))
	if sub and (player:GetAttribute("HasSaved") or player:GetAttribute("HasChosen")) then
		chosenSubclass = sub
		chosenCategory = Classes.GetCategory(sub.Category)
		chosenSkills = {}
		for i = 1, 3 do
			local id = player:GetAttribute("Skill" .. i)
			if id and sub.SkillById[id] then
				table.insert(chosenSkills, id)
			end
		end
		step = 3
	else
		step = 1
	end
	render()
	gui.Enabled = true
end

function LoadoutUI.Close()
	isOpen = false
	if gui then
		gui.Enabled = false
	end
end

function LoadoutUI.Toggle()
	if isOpen then
		LoadoutUI.Close()
	else
		LoadoutUI.Open()
	end
end

function LoadoutUI.Init()
	gui = New("ScreenGui", {
		Name = "QA_Loadout",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 20,
		Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})

	New("Frame", {
		Name = "Dim",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Background,
		BackgroundTransparency = 0.12,
		Active = true,
		Parent = gui,
	})

	local root = Theme.ScaledRoot(gui)

	titleLabel = Theme.Label({
		Name = "Title",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, -330),
		Size = UDim2.fromOffset(1000, 48),
		Font = Theme.FontBlack,
		TextSize = 38,
		Parent = root,
	})
	subtitleLabel = Theme.Label({
		Name = "Subtitle",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, -280),
		Size = UDim2.fromOffset(1000, 26),
		TextSize = 18,
		TextColor3 = Theme.SubText,
		Parent = root,
	})

	content = New("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, -30),
		Size = UDim2.fromOffset(1240, 410),
		Parent = root,
	}, {
		New("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 20),
		}),
	})

	errorLabel = Theme.Label({
		Name = "Error",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 184),
		Size = UDim2.fromOffset(900, 26),
		Font = Theme.FontBold,
		TextSize = 18,
		TextColor3 = Theme.Danger,
		Text = "",
		Parent = root,
	})

	footer = New("Frame", {
		Name = "Footer",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 214),
		Size = UDim2.fromOffset(1000, 80),
		Parent = root,
	})

	backButton = New("TextButton", {
		Name = "Back",
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.new(0.5, -610, 0.5, -330),
		Size = UDim2.fromOffset(150, 48),
		BackgroundColor3 = Theme.PanelLight,
		Font = Theme.FontBold,
		TextSize = 20,
		TextColor3 = Theme.Text,
		Text = "← ย้อนกลับ",
		Parent = root,
	}, { Theme.Corner(12) })
	backButton.Activated:Connect(function()
		if step > 1 then
			step -= 1
			render()
		end
	end)

	local closeButton = New("TextButton", {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(0.5, 610, 0.5, -330),
		Size = UDim2.fromOffset(48, 48),
		BackgroundColor3 = Theme.PanelLight,
		Font = Theme.FontBold,
		TextSize = 22,
		TextColor3 = Theme.Text,
		Text = "✕",
		Parent = root,
	}, { Theme.Corner(12) })
	closeButton.Activated:Connect(LoadoutUI.Close)

	Remotes.SkillFeedback.OnClientEvent:Connect(function(message)
		if type(message) ~= "table" then
			return
		end
		if message.Type == "LoadoutRejected" then
			errorLabel.Text = "เลือกไม่สำเร็จ: " .. tostring(message.Reason or "")
		elseif message.Type == "LoadoutAccepted" then
			LoadoutUI.Close()
		end
	end)

	-- ลงสนามแล้วปิดหน้าเลือกสาย / กลับ Lobby แล้วเปิดให้เลือกใหม่
	player:GetAttributeChangedSignal("InArena"):Connect(function()
		if player:GetAttribute("InArena") then
			LoadoutUI.Close()
		else
			LoadoutUI.Open()
		end
	end)

	-- เกิดใน Lobby แล้วหน้าเลือกสายเด้งขึ้นมาเอง
	local function onCharacter()
		task.wait(0.5)
		if not player:GetAttribute("InArena") then
			LoadoutUI.Open()
		end
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter)
	end
end

return LoadoutUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">MobileButtons</string>
              <string name="Source"><![CDATA[-- ปุ่มบนจอสำหรับมือถือ/แท็บเล็ต (แสดงเฉพาะเครื่องที่มีจอสัมผัส)
-- ปุ่มวงกลมขนาด ≥ 70px อยู่ด้านขวา จัดวางหลบปุ่มกระโดดของ Roblox
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Classes = require(Shared:WaitForChild("Classes"))

local Theme = require(script.Parent.Theme)
local New = Theme.New

local player = Players.LocalPlayer

local MobileButtons = {}

local function makeButton(parent, name, size, offset, text)
	local button = New("TextButton", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, offset.X, 1, offset.Y),
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.25,
		AutoButtonColor = false,
		Font = Theme.FontBold,
		TextSize = math.floor(size * 0.45),
		TextColor3 = Theme.Text,
		Text = text,
		Parent = parent,
	}, {
		Theme.Round(),
		New("UIAspectRatioConstraint", { AspectRatio = 1 }),
	})
	local stroke = Theme.Stroke(Theme.Accent, 3, 0.1)
	stroke.Parent = button

	local clip = New("Frame", {
		Name = "CooldownClip",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		ZIndex = 2,
		Parent = button,
	})
	New("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = Color3.fromRGB(5, 5, 10),
		BackgroundTransparency = 0.2,
		ZIndex = 2,
		Parent = clip,
	}, { Theme.Round() })
	local timer = Theme.Label({
		Name = "Timer",
		Size = UDim2.fromScale(1, 1),
		Font = Theme.FontBlack,
		TextSize = math.floor(size * 0.32),
		Text = "",
		ZIndex = 3,
		Parent = button,
	})
	return { Button = button, Stroke = stroke, Clip = clip, Timer = timer }
end

function MobileButtons.Init(InputController)
	if not InputController.IsTouch then
		return
	end

	local gui = New("ScreenGui", {
		Name = "QA_MobileButtons",
		ResetOnSpawn = false,
		DisplayOrder = 6,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})

	-- กลุ่มปุ่มต่อสู้ (แสดงเฉพาะตอนอยู่ในสนาม)
	local combat = New("Frame", {
		Name = "Combat",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = gui,
	})

	-- ตำแหน่งนับจากมุมขวาล่าง: เว้นพื้นที่ปุ่มกระโดดของ Roblox (ราว 190×230px ที่มุม)
	local buttons = {
		["0"] = makeButton(combat, "Attack", 96, Vector2.new(-250, -80), "⚔"),
		dash = makeButton(combat, "Dash", 72, Vector2.new(-355, -70), "💨"),
		["1"] = makeButton(combat, "Skill1", 76, Vector2.new(-290, -185), "1"),
		["2"] = makeButton(combat, "Skill2", 76, Vector2.new(-195, -265), "2"),
		["3"] = makeButton(combat, "Skill3", 76, Vector2.new(-85, -305), "3"),
	}

	buttons["0"].Button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			InputController.SetHoldingBasic(true)
		end
	end)
	buttons["0"].Button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			InputController.SetHoldingBasic(false)
		end
	end)
	buttons.dash.Button.Activated:Connect(function()
		InputController.Trigger("dash")
	end)
	for slot = 1, 3 do
		buttons[tostring(slot)].Button.Activated:Connect(function()
			InputController.Trigger(slot)
		end)
	end

	-- ปุ่ม ☰ มุมบน: เปิดหน้าเลือกสาย (ใน Lobby) / กลับ Lobby (ในสนาม)
	local menu = New("TextButton", {
		Name = "Menu",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(74, 74),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.25,
		Font = Theme.FontBold,
		TextSize = 34,
		TextColor3 = Theme.Text,
		Text = "☰",
		Parent = gui,
	}, { Theme.Round(), New("UIAspectRatioConstraint", { AspectRatio = 1 }), Theme.Stroke(Theme.SubText, 2, 0.2) })
	menu.Activated:Connect(function()
		InputController.OpenMenu()
	end)

	local function refreshLoadout()
		local sub = Classes.GetSubclass(player:GetAttribute("Subclass"))
		if not sub then
			return
		end
		local color = Theme.Readable(sub.Color)
		buttons["0"].Stroke.Color = color
		for i = 1, 3 do
			local skill = sub.SkillById[player:GetAttribute("Skill" .. i) or ""]
			local entry = buttons[tostring(i)]
			entry.Button.Text = skill and skill.Icon or tostring(i)
			entry.Stroke.Color = color
		end
	end
	for _, name in ipairs({ "Subclass", "Skill1", "Skill2", "Skill3" }) do
		player:GetAttributeChangedSignal(name):Connect(refreshLoadout)
	end
	refreshLoadout()

	local function refreshArena()
		combat.Visible = player:GetAttribute("InArena") == true
		if not combat.Visible then
			InputController.SetHoldingBasic(false)
		end
	end
	player:GetAttributeChangedSignal("InArena"):Connect(refreshArena)
	refreshArena()

	RunService.RenderStepped:Connect(function()
		for key, entry in pairs(buttons) do
			local cooldown = InputController.Cooldowns[key]
			if key ~= "0" and cooldown and cooldown.Remaining > 0.05 then
				entry.Clip.Size = UDim2.fromScale(1, math.clamp(cooldown.Remaining / math.max(cooldown.Total, 0.05), 0, 1))
				entry.Timer.Text = string.format(cooldown.Remaining >= 10 and "%d" or "%.1f", cooldown.Remaining)
			else
				entry.Clip.Size = UDim2.fromScale(1, 0)
				entry.Timer.Text = ""
			end
		end
	end)
end

return MobileButtons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[-- ตัวช่วยสร้าง UI และสีที่ใช้ร่วมกัน
local Workspace = game:GetService("Workspace")

local Theme = {}

Theme.Background = Color3.fromRGB(12, 13, 22)
Theme.Panel = Color3.fromRGB(24, 26, 40)
Theme.PanelLight = Color3.fromRGB(38, 41, 60)
Theme.Text = Color3.fromRGB(240, 244, 255)
Theme.SubText = Color3.fromRGB(165, 172, 200)
Theme.Accent = Color3.fromRGB(0, 255, 213)
Theme.Danger = Color3.fromRGB(255, 80, 90)
Theme.Font = Enum.Font.GothamMedium
Theme.FontBold = Enum.Font.GothamBold
Theme.FontBlack = Enum.Font.GothamBlack

Theme.DesignSize = Vector2.new(1280, 720)

-- สร้าง Instance พร้อมตั้งค่าและลูก
function Theme.New(className, props, children)
	local instance = Instance.new(className)
	local parent
	for key, value in pairs(props or {}) do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Theme.Corner(radius)
	return Theme.New("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function Theme.Round()
	return Theme.New("UICorner", { CornerRadius = UDim.new(1, 0) })
end

function Theme.Stroke(color, thickness, transparency)
	return Theme.New("UIStroke", {
		Color = color,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Theme.Label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextColor3 = Theme.Text,
		TextSize = 18,
		TextWrapped = true,
	}
	for key, value in pairs(props) do
		defaults[key] = value
	end
	return Theme.New("TextLabel", defaults)
end

-- ทำให้สีเข้มมากอ่านออกบนพื้นมืด
function Theme.Readable(color)
	local h, s, v = color:ToHSV()
	return Color3.fromHSV(h, s * 0.85, math.max(v, 0.8))
end

-- กรอบหลักที่ย่อ/ขยายตามขนาดจอด้วย UIScale (ออกแบบที่ 1280×720)
function Theme.ScaledRoot(screenGui, name)
	local root = Theme.New("Frame", {
		Name = name or "Root",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		Parent = screenGui,
	})
	local scale = Theme.New("UIScale", { Parent = root })

	local function update()
		local camera = Workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Theme.DesignSize
		local factor = math.clamp(math.min(viewport.X / Theme.DesignSize.X, viewport.Y / Theme.DesignSize.Y), 0.45, 2)
		scale.Scale = factor
		-- ชดเชยขนาด เพื่อให้กรอบยังเต็มจอหลังถูกย่อ/ขยาย
		root.Size = UDim2.fromScale(1 / factor, 1 / factor)
	end

	local connection
	local function hook()
		if connection then
			connection:Disconnect()
		end
		local camera = Workspace.CurrentCamera
		if camera then
			connection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
		end
		update()
	end
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hook)
	hook()
	return root
end

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">VFXController</string>
            <string name="Source"><![CDATA[-- เล่นเอฟเฟกต์ตามที่ server สั่ง + ตัวเลขดาเมจลอย + การล่องหน + ควันบังชื่อ
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local VFX = require(Shared:WaitForChild("VFX"))

local player = Players.LocalPlayer

local VFXController = {}

---------------------------------------------------------------------------
-- ตัวเลขดาเมจลอย (เฉพาะผู้ตีเห็น)
---------------------------------------------------------------------------
local function damageNumber(position, amount, shielded)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	holder.Position = position + Vector3.new((math.random() - 0.5) * 3, 3 + math.random(), (math.random() - 0.5) * 3)

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(120, 50)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Parent = holder

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextSize = amount >= 30 and 34 or 26
	label.Text = tostring(amount)
	label.TextColor3 = shielded and Color3.fromRGB(120, 210, 255) or (amount >= 30 and Color3.fromRGB(255, 210, 60) or Color3.new(1, 1, 1))
	label.TextStrokeTransparency = 0.2
	label.Parent = gui

	local folder = Workspace:FindFirstChild("LocalEffects") or Workspace
	holder.Parent = folder

	local info = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(gui, info, { StudsOffset = Vector3.new(0, 3.5, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()
	Debris:AddItem(holder, 0.9)
end

---------------------------------------------------------------------------
-- ล่องหน: คนอื่นเห็นโปร่งใส 0.9 ตัวเองเห็นจาง ๆ
---------------------------------------------------------------------------
local hidden = {} -- [character] = { [instance] = ค่าความโปร่งใสเดิม }

local function setInvisible(character, invisible)
	if invisible then
		if hidden[character] then
			return
		end
		local original = {}
		hidden[character] = original
		local amount = character == player.Character and 0.6 or 0.9
		for _, item in ipairs(character:GetDescendants()) do
			if (item:IsA("BasePart") or item:IsA("Decal")) and item.Transparency < 1 then
				original[item] = item.Transparency
				item.Transparency = math.max(item.Transparency, amount)
			end
		end
	else
		local original = hidden[character]
		if not original then
			return
		end
		hidden[character] = nil
		for item, transparency in pairs(original) do
			if item.Parent then
				item.Transparency = transparency
			end
		end
	end
end

local function watchCharacter(character)
	character:GetAttributeChangedSignal("Invisible"):Connect(function()
		setInvisible(character, character:GetAttribute("Invisible") == true)
	end)
	if character:GetAttribute("Invisible") then
		setInvisible(character, true)
	end
	character.Destroying:Connect(function()
		hidden[character] = nil
	end)
end

local function watchPlayer(other)
	other.CharacterAdded:Connect(watchCharacter)
	if other.Character then
		watchCharacter(other.Character)
	end
end

local function inSmoke(position)
	local now = os.clock()
	for i = #VFX.SmokeZones, 1, -1 do
		local zone = VFX.SmokeZones[i]
		if zone.Expires <= now then
			table.remove(VFX.SmokeZones, i)
		elseif (zone.Position - position).Magnitude <= zone.Radius then
			return true
		end
	end
	return false
end

-- ซ่อนชื่อ/แถบเลือดเหนือหัว: เมื่อเราอยู่ในควัน หรือเป้าล่องหน/อยู่ในควัน
local function updateOverheads()
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local blind = myRoot ~= nil and inSmoke(myRoot.Position)
	for _, other in ipairs(Players:GetPlayers()) do
		local character = other.Character
		local head = character and character:FindFirstChild("Head")
		local gui = head and head:FindFirstChild("QA_Overhead")
		if gui then
			local hide = blind or character:GetAttribute("Invisible") == true or inSmoke(head.Position)
			gui.Enabled = not hide
		end
	end
end

function VFXController.Init()
	Remotes.PlayVFX.OnClientEvent:Connect(function(effectId, data)
		local ok, err = pcall(VFX.Play, effectId, data)
		if not ok then
			warn("[VFX] " .. tostring(effectId) .. ": " .. tostring(err))
		end
	end)

	Remotes.SkillFeedback.OnClientEvent:Connect(function(message)
		if type(message) == "table" and message.Type == "Damage" then
			damageNumber(message.Position, message.Amount, message.Shielded)
		end
	end)

	Players.PlayerAdded:Connect(watchPlayer)
	for _, other in ipairs(Players:GetPlayers()) do
		watchPlayer(other)
	end

	task.spawn(function()
		while true do
			task.wait(0.15)
			updateOverheads()
		end
	end)
end

return VFXController
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
