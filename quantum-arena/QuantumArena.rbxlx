        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Time</string>
            <string name="Source"><![CDATA[-- สายย่อย: เวลา (สายใหญ่: พลัง)
return {
	Id = "Time",
	Category = "Power",
	DisplayName = "เวลา",
	Icon = "⏳",
	Color = Color3.fromHex("#FFD700"),
	Description = "หยุด ย้อน และเร่งเวลา ควบคุมจังหวะการต่อสู้",
	Basic = {
		Name = "เข็มนาฬิกา",
		Type = "Spread",
		Damage = 5, Range = 50, Cooldown = 0.5, Speed = 130, Radius = 0.6,
		Count = 3, SpreadAngle = 8,
	},
	Skills = {
		{
			Id = "TimeStop", Name = "หยุดเวลา", Icon = "⏸",
