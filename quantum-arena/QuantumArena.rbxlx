}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">ShadowScythe</string>
            <string name="Source"><![CDATA[-- สายย่อย: เคียวเงา (สายใหญ่: อาวุธ)
