      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Classes</string>
          <string name="Source"><![CDATA[-- โครงสายใหญ่ / สายย่อย และตัวช่วยค้นหาข้อมูลสกิล
local SkillData = script.Parent:WaitForChild("SkillData")

local Classes = {}

Classes.Categories = {
	{
		Id = "Power",
		DisplayName = "พลัง",
		Icon = "🔮",
		Color = Color3.fromHex("#8A2BE2"),
		Description = "ควบคุมมิติ เวลา และสายฟ้า สู้จากระยะไกลด้วยพลังพิเศษ",
		Subclasses = { "Dimension", "Time", "Lightning" },
	},
	{
		Id = "Weapon",
		DisplayName = "อาวุธ",
		Icon = "⚔️",
		Color = Color3.fromHex("#00FFD5"),
		Description = "ดาบ ปืน และเคียว อาวุธแห่งอนาคตที่ทรงพลัง",
		Subclasses = { "QuantumSword", "EnergyGun", "ShadowScythe" },
	},
	{
		Id = "Combat",
		DisplayName = "ทักษะต่อสู้",
		Icon = "👊",
		Color = Color3.fromHex("#FF8C00"),
		Description = "หมัดเทพและวิชานินจา ประชิดตัวรวดเร็ว",
		Subclasses = { "DivineFist", "Ninja" },
	},
}

Classes.Subclasses = {}
Classes.SubclassOrder = {}

for _, category in ipairs(Classes.Categories) do
	for _, subId in ipairs(category.Subclasses) do
		local data = require(SkillData:WaitForChild(subId))
		data.SkillById = {}
		for index, skill in ipairs(data.Skills) do
			skill.Index = index
			data.SkillById[skill.Id] = skill
		end
		Classes.Subclasses[subId] = data
		table.insert(Classes.SubclassOrder, subId)
	end
end

function Classes.GetCategory(categoryId)
	for _, category in ipairs(Classes.Categories) do
		if category.Id == categoryId then
			return category
		end
	end
	return nil
end

function Classes.GetSubclass(subclassId)
	if type(subclassId) ~= "string" then
		return nil
	end
	return Classes.Subclasses[subclassId]
end

function Classes.GetSkill(subclassId, skillId)
	local sub = Classes.GetSubclass(subclassId)
	if not sub or type(skillId) ~= "string" then
		return nil
	end
	return sub.SkillById[skillId]
end

-- ตรวจว่าชุดสกิลถูกต้อง: สายย่อยมีจริง, ครบ 3, มีจริงทุกอัน, ไม่ซ้ำ
function Classes.ValidateLoadout(subclassId, skills)
	local sub = Classes.GetSubclass(subclassId)
	if not sub then
		return false, "ไม่พบสายย่อยนี้"
	end
	if type(skills) ~= "table" or #skills ~= 3 then
		return false, "ต้องเลือกสกิลให้ครบ 3 อัน"
	end
	local seen = {}
	for i = 1, 3 do
		local id = skills[i]
		if type(id) ~= "string" or not sub.SkillById[id] then
			return false, "มีสกิลที่ไม่อยู่ในสายนี้"
		end
		if seen[id] then
			return false, "เลือกสกิลซ้ำไม่ได้"
		end
		seen[id] = true
	end
	return true, nil
end

return Classes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- ค่าคงที่ทั้งหมดของเกม (แก้สมดุลเกมได้ที่ไฟล์นี้)
local Config = {}

Config.MaxHealth = 150
Config.WalkSpeed = 18
Config.JumpPower = 50

Config.Dash = {
	Distance = 25,
	Cooldown = 3,
	IFrame = 0.2,
	Duration = 0.15,
}

Config.RespawnTime = 4
Config.SpawnProtection = 3
Config.Regen = { Rate = 3, Delay = 6 }
Config.KillHeal = 30
Config.AssistWindow = 5

Config.Stun = { MaxDuration = 2, ResistAfter = 1 }

Config.RemoteRateLimit = 20 -- ครั้ง/วินาที ต่อผู้เล่น
Config.ReturnToLobbyCombatDelay = 5 -- ต้องไม่โดนตีกี่วิถึงกลับ Lobby ได้

Config.KillFeed = { MaxLines = 5, Lifetime = 6 }
Config.Streaks = {
	[5] = "กำลังอาละวาด!",
	[10] = "หยุดไม่อยู่!",
}

Config.Lobby = {
	Center = Vector3.new(0, 300, 0),
	Size = 80,
	SafeY = 200, -- สูงกว่านี้ถือว่าอยู่ใน Lobby (ตีกันไม่ได้)
}

Config.Arena = {
	Radius = 150,
	KillY = -50,
	SpawnRadius = 135,
	SpawnCount = 8,
}

Config.DefaultLoadout = {
	Subclass = "QuantumSword",
	Skills = { "SuperpositionSlash", "EntangleThrow", "QuantumWave" },
}

Config.DataStoreName = "QuantumArenaLoadout_v1"

-- ชื่อ collision group
Config.Groups = { Players = "QA_Players", Phased = "QA_Phased" }

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- สร้าง (ฝั่ง server) หรืออ้างอิง (ฝั่ง client) RemoteEvent ทั้งหมดของเกม
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local NAMES = {
	"SelectLoadout", -- C→S: subclassId, {skillId×3}
	"UseSkill", -- C→S: slot (0=basic, 1–3, "dash"), aimPosition
	"ReturnToLobby", -- C→S: ขอกลับ Lobby เพื่อเปลี่ยนสาย
	"SkillFeedback", -- S→C: ผลการใช้สกิล / คูลดาวน์ / ตัวเลขดาเมจ
	"PlayVFX", -- S→All: effectId, data
	"KillFeed", -- S→All: killer, victim, skillName, assists
	"Announce", -- S→All: ข้อความประกาศ, สี
}

local Remotes = {}

local folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in ipairs(NAMES) do
		local remote = folder:FindFirstChild(name)
		if not remote then
			remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
		Remotes[name] = remote
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
	for _, name in ipairs(NAMES) do
		Remotes[name] = folder:WaitForChild(name)
	end
end

return Remotes
]]></string>
        </Properties>
      </Item>
